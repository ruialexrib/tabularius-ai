@model TabulariusAI.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alterar palavra-passe - Tabularius AI</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-brand-panel">
            <div class="auth-brand"><span class="brand-mark">T</span><span>Tabularius AI</span></div>
            <div><p class="auth-kicker">Primeiro acesso</p><h1>Defina a sua palavra-passe.</h1><p>Por segurança, a palavra-passe temporária tem de ser substituída antes de utilizar a aplicação.</p></div>
            <small>© @DateTime.Today.Year Tabularius AI · Rui Ribeiro · MIT</small>
        </section>
        <section class="auth-form-panel">
            <form asp-action="ChangePassword" method="post" class="auth-card">
                <header><span class="auth-icon">T</span><div><h2>Alterar palavra-passe</h2><p>A nova palavra-passe será utilizada nos próximos acessos.</p></div></header>
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>
                <label asp-for="CurrentPassword">Palavra-passe atual</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus /><span asp-validation-for="CurrentPassword"></span>
                <label asp-for="NewPassword">Nova palavra-passe</label><input asp-for="NewPassword" type="password" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span>
                <label asp-for="ConfirmPassword">Confirmar nova palavra-passe</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span>
                <p class="auth-note">Mínimo de 12 caracteres, incluindo maiúscula, minúscula, algarismo e carácter especial.</p>
                <button type="submit" class="auth-primary">Guardar nova palavra-passe</button>
            </form>
        </section>
    </main>
</body>
</html>
