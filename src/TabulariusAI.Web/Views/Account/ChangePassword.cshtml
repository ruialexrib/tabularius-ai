@model TabulariusAI.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
    var mandatory = ViewData["MandatoryPasswordChange"] as bool? == true;
    var hasErrors = !ViewData.ModelState.IsValid;
    if (mandatory) Layout = null;
}
@if (mandatory)
{
<!DOCTYPE html>
<html lang="pt-PT"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>Alterar palavra-passe - Tabularius AI</title><link rel="icon" type="image/svg+xml" href="~/favicon.svg"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/auth.css" asp-append-version="true"/></head><body class="auth-page"><main class="auth-shell"><section class="auth-brand-panel"><div class="auth-brand"><span class="brand-mark">T</span><span>Tabularius AI</span></div><div><p class="auth-kicker">Primeiro acesso</p><h1>Defina a sua palavra-passe.</h1><p>Por segurança, a palavra-passe temporária tem de ser substituída antes de utilizar a aplicação.</p></div><small>© @DateTime.Today.Year Tabularius AI · Rui Ribeiro · MIT</small></section><section class="auth-form-panel"><form asp-action="ChangePassword" method="post" class="auth-card"><header><span class="auth-icon">T</span><div><h2>Alterar palavra-passe</h2><p>A nova palavra-passe será utilizada nos próximos acessos.</p></div></header><div asp-validation-summary="ModelOnly" class="auth-validation"></div><label asp-for="CurrentPassword">Palavra-passe atual</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus/><span asp-validation-for="CurrentPassword"></span><label asp-for="NewPassword">Nova palavra-passe</label><input asp-for="NewPassword" type="password" autocomplete="new-password"/><span asp-validation-for="NewPassword"></span><label asp-for="ConfirmPassword">Confirmar nova palavra-passe</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span><p class="auth-note">Mínimo de 12 caracteres, incluindo maiúscula, minúscula, algarismo e carácter especial.</p><button type="submit" class="auth-primary">Guardar nova palavra-passe</button></form></section></main></body></html>
}
else
{
<section class="user-editor-page" aria-labelledby="password-editor-title">
    <div class="user-editor-card">
        <div class="user-editor-main">
            <div class="user-editor-icon" aria-hidden="true">P</div>
            <div class="user-editor-copy">
                <p class="eyebrow">Preferências · Segurança</p>
                <h1 id="password-editor-title">Alterar palavra-passe</h1>
                <p class="lead">Atualize a credencial utilizada para autenticação local no Tabularius AI.</p>
                @if (hasErrors)
                {
                    <div class="user-editor-alert" role="alert"><span aria-hidden="true">!</span><div><strong>Não foi possível alterar a palavra-passe</strong><div asp-validation-summary="All"></div></div></div>
                }
                <form asp-action="ChangePassword" method="post" class="user-editor-form">
                    <div class="user-editor-section">
                        <div class="user-editor-section-heading"><span>01</span><div><strong>Credencial atual</strong><small>Confirme a sua palavra-passe atual antes de definir uma nova.</small></div></div>
                        <div class="user-editor-grid">
                            <div class="user-editor-field user-editor-field-wide"><label asp-for="CurrentPassword">Palavra-passe atual</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus placeholder="Introduza a palavra-passe atual"/><span asp-validation-for="CurrentPassword"></span></div>
                        </div>
                    </div>
                    <div class="user-editor-section">
                        <div class="user-editor-section-heading"><span>02</span><div><strong>Nova credencial</strong><small>Defina e confirme a nova palavra-passe da sua conta.</small></div></div>
                        <div class="user-editor-grid">
                            <div class="user-editor-field"><label asp-for="NewPassword">Nova palavra-passe</label><input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Defina uma palavra-passe segura"/><span asp-validation-for="NewPassword"></span></div>
                            <div class="user-editor-field"><label asp-for="ConfirmPassword">Confirmar palavra-passe</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repita a nova palavra-passe"/><span asp-validation-for="ConfirmPassword"></span></div>
                        </div>
                        <div class="user-password-rule"><span aria-hidden="true">✓</span><p><strong>Política de segurança</strong><small>Mínimo de 12 caracteres, com maiúscula, minúscula, algarismo e carácter especial.</small></p></div>
                    </div>
                    <div class="user-editor-actions"><button type="submit" class="btn btn-primary">Guardar nova palavra-passe</button><a class="btn btn-secondary" asp-action="Preferences">Cancelar</a></div>
                </form>
            </div>
        </div>
        <aside class="user-editor-reference" aria-label="Informação sobre alteração da palavra-passe">
            <span class="user-editor-reference-label">Segurança da conta</span>
            <h2>Proteja o seu acesso</h2>
            <p>A alteração substitui imediatamente a palavra-passe utilizada para iniciar sessão localmente.</p>
            <div class="user-role-cards">
                <div><span>01</span><p><strong>Confirme a atual</strong><small>A credencial existente é validada antes de qualquer alteração.</small></p></div>
                <div><span>02</span><p><strong>Defina uma nova</strong><small>Utilize uma palavra-passe exclusiva que cumpra a política de segurança.</small></p></div>
            </div>
            <div class="user-editor-reference-note"><strong>Depois de guardar</strong><span>A sessão atual é atualizada e a nova palavra-passe passa a ser utilizada nos próximos acessos.</span></div>
        </aside>
    </div>
</section>
}
