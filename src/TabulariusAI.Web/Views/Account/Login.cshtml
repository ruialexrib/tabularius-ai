@model TabulariusAI.Web.Models.LoginViewModel
@inject TabulariusAI.Web.Models.ApplicationInfo AppInfo
@{
    ViewData["Title"] = "Iniciar sessão";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sessão - Tabularius AI</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    @if (Model.ShowBootstrapCredentials)
    {
        <aside class="bootstrap-toast" role="status" aria-live="polite">
            <strong>Primeira utilização</strong>
            <span>Use as credenciais iniciais:</span>
            <span><b>Utilizador:</b> admin</span>
            <span><b>Palavra-passe:</b> LetMeIn</span>
            <small>Será obrigatório definir uma nova palavra-passe após a entrada.</small>
            <button type="button" class="bootstrap-toast-action" id="useBootstrapCredentials">Usar as credenciais</button>
            <span class="bootstrap-toast-progress" aria-hidden="true"></span>
        </aside>
    }
    <main class="auth-shell">
        <section class="auth-brand-panel">
            <div class="auth-brand"><span class="brand-mark">T</span><span>Tabularius AI</span></div>
            <div><p class="auth-kicker">Análise e controlo contabilístico</p><h1>Tabularius AI</h1><p>Um espaço de trabalho local para explorar SAF-T (PT), estruturar dossiers contabilísticos e evoluir da consulta de dados para análise, reconciliação, testes e inteligência assistida.</p></div>
            <small>Tabularius AI v@(AppInfo.Version) · © @DateTime.Today.Year Rui Ribeiro · Licença MIT</small>
        </section>
        <section class="auth-form-panel">
            <form asp-action="Login" method="post" class="auth-card">
                <input asp-for="ReturnUrl" type="hidden" />
                <header><span class="auth-icon">T</span><div><h2>Iniciar sessão</h2><p>Introduza as credenciais da sua conta.</p></div></header>
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>
                <label asp-for="Identifier">Utilizador</label><input asp-for="Identifier" autocomplete="username" autofocus /><span asp-validation-for="Identifier"></span>
                <label asp-for="Password">Palavra-passe</label><input asp-for="Password" type="password" autocomplete="current-password" /><span asp-validation-for="Password"></span>
                <label class="auth-check"><input asp-for="RememberMe" /> <span>Manter sessão iniciada</span></label>
                <button type="submit" class="auth-primary">Entrar</button>
                @if (Model.GoogleEnabled)
                {
                    <div class="auth-divider"><span>ou</span></div>
                    <button type="submit" class="auth-google" formaction="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = Model.ReturnUrl })">Continuar com Google</button>
                }
                <p class="auth-note">O acesso é reservado a contas previamente autorizadas.</p>
            </form>
        </section>
    </main>
    @if (Model.ShowBootstrapCredentials)
    {
        <script>
            document.getElementById('useBootstrapCredentials')?.addEventListener('click', function () {
                const identifier = document.getElementById('Identifier');
                const password = document.getElementById('Password');
                if (identifier) identifier.value = 'admin';
                if (password) password.value = 'LetMeIn';
                password?.focus();
            });
        </script>
    }
</body>
</html>
