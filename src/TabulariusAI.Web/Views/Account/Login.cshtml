@model TabulariusAI.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sessão";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sessão - Tabularius AI</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-brand-panel">
            <div class="auth-brand"><span class="brand-mark">T</span><span>Tabularius AI</span></div>
            <div><p class="auth-kicker">Contabilidade · SAF-T (PT) · Análise</p><h1>Dados contabilísticos com contexto e controlo.</h1><p>Aceda ao seu espaço de trabalho para gerir entidades, dossiers e análises.</p></div>
            <small>© @DateTime.Today.Year Tabularius AI · Rui Ribeiro · MIT</small>
        </section>
        <section class="auth-form-panel">
            <form asp-action="Login" method="post" class="auth-card">
                <input asp-for="ReturnUrl" type="hidden" />
                <header><span class="auth-icon">T</span><div><h2>Iniciar sessão</h2><p>Introduza as credenciais da sua conta.</p></div></header>
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>
                <label asp-for="Email">Email</label><input asp-for="Email" autocomplete="username" autofocus /><span asp-validation-for="Email"></span>
                <label asp-for="Password">Palavra-passe</label><input asp-for="Password" type="password" autocomplete="current-password" /><span asp-validation-for="Password"></span>
                <label class="auth-check"><input asp-for="RememberMe" /> <span>Manter sessão iniciada</span></label>
                <button type="submit" class="auth-primary">Entrar</button>
                @if (Model.GoogleEnabled)
                {
                    <div class="auth-divider"><span>ou</span></div>
                    <button type="submit" class="auth-google" formaction="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = Model.ReturnUrl })">Continuar com Google</button>
                }
                <p class="auth-note">O acesso é reservado a contas previamente autorizadas.</p>
            </form>
        </section>
    </main>
</body>
</html>
