@model TabulariusAI.Web.Data.Entities.AccountingEntity
@{
    ViewData["Title"] = Model.Name;
}

<section class="hero">
    <p class="eyebrow">Entidade</p>
    <h1>@Model.Name</h1>
    <p class="lead">NIF @Model.TaxRegistrationNumber · Selecione o exercício contabilístico que pretende analisar.</p>
</section>

<section class="panel">
    <h2>Exercícios</h2>
    @if (Model.Dossiers.Count == 0)
    {
        <p>Esta entidade ainda não tem dossiers de análise.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Exercício</th><th>Dossier</th><th>SAF-T (PT)</th><th></th></tr></thead>
                <tbody>
                @foreach (var dossier in Model.Dossiers.OrderByDescending(item => item.FiscalYear))
                {
                    <tr>
                        <td><strong>@dossier.FiscalYear</strong></td>
                        <td>@dossier.Name</td>
                        <td>@dossier.Imports.Count importação(ões)</td>
                        <td><a asp-controller="Dossier" asp-action="Details" asp-route-id="@dossier.Id">Abrir dossier</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
