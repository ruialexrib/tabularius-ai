@model TabulariusAI.Web.Data.Entities.AnalysisDossier
@{ ViewData["Title"] = $"{Model.AccountingEntity.Name} · {Model.FiscalYear}"; }
<section class="page-header"><div><p class="eyebrow">Dossier contabilístico</p><h1>@Model.AccountingEntity.Name · @Model.FiscalYear</h1><p class="lead">Espaço de trabalho do exercício para consultar fontes, análises, reconciliações, testes e relatórios.</p></div><a class="btn btn-secondary" asp-action="Entity" asp-route-id="@Model.AccountingEntityId">Voltar à entidade</a></section>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="status-message status-success">@successMessage</div> }
<section class="panel dossier-workspace-panel"><div class="card-header"><div><p class="section-kicker">Dados SAF-T (PT)</p><h2>Explorar fonte contabilística</h2><p>Consulte os dados da fonte SAF-T (PT) selecionada, desde os ficheiros mestre aos documentos e lançamentos contabilísticos.</p></div></div><nav class="workspace-tabs" aria-label="Áreas SAF-T (PT)"><a asp-action="SaftSummary" asp-route-id="@Model.Id"><span class="workspace-tab-icon">01</span><span><strong>Resumo</strong><small>Visão geral da fonte</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Accounts" asp-route-id="@Model.Id"><span class="workspace-tab-icon">02</span><span><strong>Contas</strong><small>Plano de contas</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Customers" asp-route-id="@Model.Id"><span class="workspace-tab-icon">03</span><span><strong>Clientes</strong><small>Master file de clientes</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Suppliers" asp-route-id="@Model.Id"><span class="workspace-tab-icon">04</span><span><strong>Fornecedores</strong><small>Master file de fornecedores</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Products" asp-route-id="@Model.Id"><span class="workspace-tab-icon">05</span><span><strong>Produtos</strong><small>Produtos e serviços</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="AccountingEntries" asp-route-id="@Model.Id"><span class="workspace-tab-icon">06</span><span><strong>Lançamentos contabilísticos</strong><small>Transações, débitos e créditos</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="SalesInvoices" asp-route-id="@Model.Id"><span class="workspace-tab-icon">07</span><span><strong>Documentos de vendas</strong><small>Faturas e respetivas linhas</small></span><span class="workspace-tab-arrow">›</span></a></nav></section>
<section class="panel dossier-workspace-panel"><div class="card-header"><div><p class="section-kicker">Análise contabilística</p><h2>Analisar o exercício</h2><p>Resultados calculados deterministicamente a partir da fonte SAF-T (PT) selecionada, mantendo a rastreabilidade para os dados contabilísticos.</p></div></div><nav class="workspace-tabs" aria-label="Análises contabilísticas"><a asp-action="TrialBalance" asp-route-id="@Model.Id"><span class="workspace-tab-icon">01</span><span><strong>Balancete</strong><small>Saldos iniciais, movimentos e saldos finais</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="IncomeStatement" asp-route-id="@Model.Id"><span class="workspace-tab-icon">02</span><span><strong>Demonstração de Resultados</strong><small>Rendimentos, gastos e resultado do período</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="BalanceSheet" asp-route-id="@Model.Id"><span class="workspace-tab-icon">03</span><span><strong>Balanço</strong><small>Ativo, capital próprio, passivo e controlo de equilíbrio</small></span><span class="workspace-tab-arrow">›</span></a></nav></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Rastreabilidade</p><h2>Fontes importadas</h2><p>Eliminar uma fonte remove também todos os dados que foram persistidos a partir dessa importação.</p></div></div>@if (Model.Imports.Count == 0) { <p class="empty-row">Não existem ficheiros SAF-T (PT) associados a este dossier.</p> } else { <div class="table-wrap"><table><thead><tr><th>Ficheiro SAF-T (PT)</th><th>Versão</th><th>Período</th><th>Importado em</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model.Imports.OrderByDescending(item => item.EndDate).ThenByDescending(item => item.StartDate).ThenByDescending(item => item.ImportedAtUtc)) { <tr><td><strong>@item.OriginalFileName</strong></td><td>@item.SaftVersion</td><td>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "—") – @(item.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.ImportedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><form asp-action="DeleteImport" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar a importação «@item.OriginalFileName»? Todos os dados provenientes deste SAF-T (PT) serão eliminados permanentemente.');"><button type="submit" class="btn-link-danger">Eliminar</button></form></td></tr> }</tbody></table></div> }</section>
