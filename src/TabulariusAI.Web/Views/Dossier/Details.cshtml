@model TabulariusAI.Web.Data.Entities.AnalysisDossier
@{
    ViewData["Title"] = $"{Model.AccountingEntity.Name} · {Model.FiscalYear}";
}
<section class="hero"><div><p class="eyebrow">Dossier contabilístico</p><h1>@Model.AccountingEntity.Name · @Model.FiscalYear</h1><p class="lead">Espaço de trabalho do exercício para consultar fontes, análises, reconciliações, testes e relatórios.</p></div></section>
<section class="panel">
    <div class="card-header"><div><p class="section-kicker">MasterFiles</p><h2>SAF-T (PT)</h2><p>Consulte os dados contabilísticos preservados a partir da importação mais recente.</p></div></div>
    <div class="workspace-links">
        <a asp-action="SaftSummary" asp-route-id="@Model.Id">Resumo</a>
        <a asp-action="Accounts" asp-route-id="@Model.Id">Contas</a>
        <a asp-action="Customers" asp-route-id="@Model.Id">Clientes</a>
        <a asp-action="Suppliers" asp-route-id="@Model.Id">Fornecedores</a>
        <a asp-action="Products" asp-route-id="@Model.Id">Produtos e serviços</a>
    </div>
</section>
<section class="panel">
    <div class="card-header"><div><p class="section-kicker">Rastreabilidade</p><h2>Fontes importadas</h2></div></div>
    @if (Model.Imports.Count == 0) { <p class="empty-row">Não existem ficheiros SAF-T (PT) associados a este dossier.</p> }
    else { <div class="table-wrap"><table><thead><tr><th>Ficheiro SAF-T (PT)</th><th>Versão</th><th>Período</th><th>Importado em</th></tr></thead><tbody>@foreach (var item in Model.Imports.OrderByDescending(item => item.ImportedAtUtc)) { <tr><td><strong>@item.OriginalFileName</strong></td><td>@item.SaftVersion</td><td>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "—") – @(item.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.ImportedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody></table></div> }
</section>
