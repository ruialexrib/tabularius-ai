@model TabulariusAI.Web.Data.Entities.AnalysisDossier
@{ ViewData["Title"] = $"{Model.AccountingEntity.Name} · {Model.FiscalYear}"; }
<section class="page-header"><div><p class="eyebrow">Dossier contabilístico</p><h1>@Model.AccountingEntity.Name · @Model.FiscalYear</h1><p class="lead">Espaço de trabalho do exercício para consultar fontes, análises, reconciliações, testes e relatórios.</p></div><a class="btn btn-secondary" asp-action="Entity" asp-route-id="@Model.AccountingEntityId">Voltar à entidade</a></section>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="status-message status-success">@successMessage</div> }
<section class="panel dossier-workspace-panel">
    <div class="card-header"><div><p class="section-kicker">MasterFiles</p><h2>SAF-T (PT)</h2><p>Consulte os dados contabilísticos da fonte SAF-T (PT) selecionada.</p></div></div>
    <nav class="workspace-tabs" aria-label="Áreas SAF-T (PT)">
        <a asp-action="SaftSummary" asp-route-id="@Model.Id"><span class="workspace-tab-icon" aria-hidden="true">01</span><span><strong>Resumo</strong><small>Visão geral da fonte</small></span><span class="workspace-tab-arrow" aria-hidden="true">›</span></a>
        <a asp-action="Accounts" asp-route-id="@Model.Id"><span class="workspace-tab-icon" aria-hidden="true">02</span><span><strong>Contas</strong><small>Plano de contas</small></span><span class="workspace-tab-arrow" aria-hidden="true">›</span></a>
        <a asp-action="Customers" asp-route-id="@Model.Id"><span class="workspace-tab-icon" aria-hidden="true">03</span><span><strong>Clientes</strong><small>Master file de clientes</small></span><span class="workspace-tab-arrow" aria-hidden="true">›</span></a>
        <a asp-action="Suppliers" asp-route-id="@Model.Id"><span class="workspace-tab-icon" aria-hidden="true">04</span><span><strong>Fornecedores</strong><small>Master file de fornecedores</small></span><span class="workspace-tab-arrow" aria-hidden="true">›</span></a>
    </nav>
</section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Rastreabilidade</p><h2>Fontes importadas</h2><p>Eliminar uma fonte remove também todos os dados que foram persistidos a partir dessa importação.</p></div></div>@if (Model.Imports.Count == 0) { <p class="empty-row">Não existem ficheiros SAF-T (PT) associados a este dossier.</p> } else { <div class="table-wrap"><table><thead><tr><th>Ficheiro SAF-T (PT)</th><th>Versão</th><th>Período</th><th>Importado em</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model.Imports.OrderByDescending(item => item.EndDate).ThenByDescending(item => item.StartDate).ThenByDescending(item => item.ImportedAtUtc)) { <tr><td><strong>@item.OriginalFileName</strong></td><td>@item.SaftVersion</td><td>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "—") – @(item.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.ImportedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><form asp-action="DeleteImport" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar a importação «@item.OriginalFileName»? Todos os dados provenientes deste SAF-T (PT) serão eliminados permanentemente.');"><button type="submit" class="btn-link-danger">Eliminar</button></form></td></tr> }</tbody></table></div> }</section>
