@model TabulariusAI.Web.Data.Entities.AnalysisDossier
@{
    ViewData["Title"] = $"{Model.AccountingEntity.Name} · {Model.FiscalYear}";
}

<section class="hero">
    <p class="eyebrow">Dossier contabilístico</p>
    <h1>@Model.AccountingEntity.Name · @Model.FiscalYear</h1>
    <p class="lead">Espaço de trabalho do exercício para consultar fontes, análises, reconciliações, testes e relatórios.</p>
</section>

<section class="panel">
    <h2>SAF-T (PT)</h2>
    <p>Consulte os dados contabilísticos preservados a partir das fontes SAF-T (PT) deste dossier.</p>
    <p><a asp-action="SaftSummary" asp-route-id="@Model.Id">Resumo SAF-T (PT)</a> · <a asp-action="Accounts" asp-route-id="@Model.Id">Contas</a></p>
</section>

<section class="panel">
    <h2>Fontes importadas</h2>
    @if (Model.Imports.Count == 0)
    {
        <p>Não existem ficheiros SAF-T (PT) associados a este dossier.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Ficheiro SAF-T (PT)</th><th>Versão</th><th>Período</th><th>Importado em</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Imports.OrderByDescending(item => item.ImportedAtUtc))
                {
                    <tr><td><strong>@item.OriginalFileName</strong></td><td>@item.SaftVersion</td><td>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "—") – @(item.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.ImportedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
