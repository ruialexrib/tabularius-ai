@using Microsoft.EntityFrameworkCore
@using TabulariusAI.Web.Data
@inject TabulariusDbContext DbContext
@model TabulariusAI.Web.Data.Entities.AnalysisDossier
@{ ViewData["Title"] = $"{Model.AccountingEntity.Name} · {Model.FiscalYear}"; var aiEnabled = await DbContext.AiSettings.AsNoTracking().AnyAsync(item => item.IsEnabled); }
<section class="page-header"><div><p class="eyebrow">Dossier contabilístico</p><h1>@Model.AccountingEntity.Name · @Model.FiscalYear</h1><p class="lead">Espaço de trabalho do exercício para consultar dados, análises, reconciliações, testes e relatórios.</p></div><div class="page-header-actions dossier-header-actions">@if(aiEnabled){<a class="dossier-ai-cta" asp-controller="AiAssistant" asp-action="Index" asp-route-dossierId="@Model.Id"><span class="dossier-ai-cta-icon">✦</span><span class="dossier-ai-cta-copy"><strong>Falar com os dados</strong><small>Assistente AI</small></span><span class="dossier-ai-cta-arrow">›</span></a>}<form asp-action="DownloadBackup" asp-route-id="@Model.Id" method="post" data-no-wait><button class="btn btn-secondary" type="submit">Backup JSON</button></form><a class="btn btn-secondary" asp-action="Entity" asp-route-id="@Model.AccountingEntityId">Voltar à entidade</a></div></section>
<section class="panel dossier-workspace-panel"><div class="card-header"><div><p class="section-kicker">Dados SAF-T (PT)</p><h2>Explorar dados contabilísticos</h2><p>Consulte os dados do SAF-T (PT) selecionado, desde os ficheiros mestre aos documentos e lançamentos contabilísticos.</p></div></div><nav class="workspace-tabs"><a asp-action="SaftSummary" asp-route-id="@Model.Id"><span class="workspace-tab-icon">01</span><span><strong>Resumo</strong><small>Visão geral dos dados</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Accounts" asp-route-id="@Model.Id"><span class="workspace-tab-icon">02</span><span><strong>Contas</strong><small>Plano de contas</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Customers" asp-route-id="@Model.Id"><span class="workspace-tab-icon">03</span><span><strong>Clientes</strong><small>Master file de clientes</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Suppliers" asp-route-id="@Model.Id"><span class="workspace-tab-icon">04</span><span><strong>Fornecedores</strong><small>Master file de fornecedores</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Products" asp-route-id="@Model.Id"><span class="workspace-tab-icon">05</span><span><strong>Produtos</strong><small>Produtos e serviços</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="TaxTable" asp-route-id="@Model.Id"><span class="workspace-tab-icon">06</span><span><strong>Tabela de impostos</strong><small>Tipos, códigos e taxas</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="AccountingEntries" asp-route-id="@Model.Id"><span class="workspace-tab-icon">07</span><span><strong>Lançamentos contabilísticos</strong><small>Transações, débitos e créditos</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="SalesInvoices" asp-route-id="@Model.Id"><span class="workspace-tab-icon">08</span><span><strong>Documentos de vendas</strong><small>Faturas e respetivas linhas</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="StockMovements" asp-route-id="@Model.Id"><span class="workspace-tab-icon">09</span><span><strong>Movimentação de mercadorias</strong><small>Guias e produtos movimentados</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="WorkingDocuments" asp-route-id="@Model.Id"><span class="workspace-tab-icon">10</span><span><strong>Documentos de conferência</strong><small>Orçamentos, pro formas e documentos de trabalho</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Payments" asp-route-id="@Model.Id"><span class="workspace-tab-icon">11</span><span><strong>Recibos e pagamentos</strong><small>Recibos, liquidações e respetivos documentos</small></span><span class="workspace-tab-arrow">›</span></a></nav></section>
<section class="panel dossier-workspace-panel"><div class="card-header"><div><p class="section-kicker">Análise contabilística</p><h2>Analisar o exercício</h2><p>Resultados calculados deterministicamente a partir dos dados SAF-T (PT) selecionados, com interpretação assistida por AI quando disponível.</p></div></div><nav class="workspace-tabs"><a asp-action="TrialBalance" asp-route-id="@Model.Id"><span class="workspace-tab-icon">01</span><span><strong>Balancete</strong><small>Saldos iniciais, movimentos e saldos finais</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="IncomeStatement" asp-route-id="@Model.Id"><span class="workspace-tab-icon">02</span><span><strong>Demonstração de Resultados</strong><small>Rendimentos, gastos e resultado do período</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="BalanceSheet" asp-route-id="@Model.Id"><span class="workspace-tab-icon">03</span><span><strong>Balanço</strong><small>Ativo, capital próprio, passivo e equilíbrio</small></span><span class="workspace-tab-arrow">›</span></a></nav></section>
<section class="panel dossier-workspace-panel"><div class="card-header"><div><p class="section-kicker">Área analítica</p><h2>Investigar e controlar</h2><p>Indicadores e controlos determinísticos para orientar a revisão contabilística, com interpretação assistida por AI quando disponível.</p></div></div><nav class="workspace-tabs"><a asp-action="Analytics" asp-route-id="@Model.Id"><span class="workspace-tab-icon">01</span><span><strong>Visão geral</strong><small>Indicadores, evolução e concentração</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="Anomalies" asp-route-id="@Model.Id"><span class="workspace-tab-icon">02</span><span><strong>Anomalias</strong><small>Controlos e situações a investigar</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="AccountAnalysis" asp-route-id="@Model.Id"><span class="workspace-tab-icon">03</span><span><strong>Análise de contas</strong><small>Débitos, créditos e movimento líquido</small></span><span class="workspace-tab-arrow">›</span></a><a asp-action="VatAnalysis" asp-route-id="@Model.Id"><span class="workspace-tab-icon">04</span><span><strong>Análise de IVA</strong><small>IVA por taxa, documento e efeito líquido</small></span><span class="workspace-tab-arrow">›</span></a></nav></section>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Rastreabilidade</p><h2>Ficheiros importados</h2><p>Eliminar um ficheiro importado remove também todos os dados persistidos a partir dessa importação.</p></div></div>@if(Model.Imports.Count==0){<p class="empty-row">Não existem ficheiros SAF-T (PT) associados a este dossier.</p>}else{<div class="table-wrap"><table><thead><tr><th>Ficheiro SAF-T (PT)</th><th>Versão</th><th>Período</th><th>Importado em</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Model.Imports.OrderByDescending(x=>x.EndDate).ThenByDescending(x=>x.ImportedAtUtc)){<tr><td><strong>@item.OriginalFileName</strong></td><td>@item.SaftVersion</td><td>@(item.StartDate?.ToString("dd/MM/yyyy")??"—") – @(item.EndDate?.ToString("dd/MM/yyyy")??"—")</td><td>@item.ImportedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><div class="row-actions"><form asp-action="DeleteImport" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar esta importação e todos os respetivos dados?');"><button class="table-action" type="submit">Eliminar</button></form></div></td></tr>}</tbody></table></div>}</section>
