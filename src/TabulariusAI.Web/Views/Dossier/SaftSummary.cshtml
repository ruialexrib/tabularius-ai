@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{
    var import = Model.SelectedImport;
    ViewData["Title"] = $"Resumo SAF-T (PT) · {import.Dossier.AccountingEntity.Name}";
}
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · @import.Dossier.AccountingEntity.Name · @import.Dossier.FiscalYear</p><h1>Resumo SAF-T (PT)</h1><p class="lead">Resumo da fonte selecionada dentro deste dossier contabilístico.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model" /></section>
<section class="metric-grid saft-summary-metrics"><article class="metric-card"><span>Contas</span><strong>@import.Accounts.Count</strong></article><article class="metric-card"><span>Clientes</span><strong>@import.Customers.Count</strong></article><article class="metric-card"><span>Fornecedores</span><strong>@import.Suppliers.Count</strong></article></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Fonte selecionada</p><h2>Detalhes da importação</h2></div></div><div class="table-wrap"><table><tbody><tr><th>Entidade</th><td>@import.Dossier.AccountingEntity.Name</td></tr><tr><th>NIF</th><td>@import.Dossier.AccountingEntity.TaxRegistrationNumber</td></tr><tr><th>Exercício</th><td>@import.Dossier.FiscalYear</td></tr><tr><th>Ficheiro</th><td>@import.OriginalFileName</td></tr><tr><th>Versão SAF-T (PT)</th><td>@import.SaftVersion</td></tr><tr><th>Período</th><td>@(import.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(import.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr><tr><th>Importado em</th><td>@import.ImportedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr></tbody></table></div></section>
