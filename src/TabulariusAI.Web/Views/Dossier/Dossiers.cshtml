@model IReadOnlyCollection<TabulariusAI.Web.Data.Entities.AnalysisDossier>
@{
    ViewData["Title"] = "Dossiers";
}

<section class="hero">
    <p class="eyebrow">Dossier</p>
    <h1>Dossiers</h1>
    <p class="lead">Períodos de análise contabilística organizados por entidade e exercício.</p>
</section>

<section class="panel">
    @if (Model.Count == 0)
    {
        <p>Ainda não existem dossiers. O primeiro será criado automaticamente com uma importação SAF-T (PT).</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Entidade</th><th>Dossier</th><th>Exercício</th><th>Importações</th><th>Criado em</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr><td><strong>@item.AccountingEntity.Name</strong></td><td>@item.Name</td><td>@item.FiscalYear</td><td>@item.Imports.Count</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
