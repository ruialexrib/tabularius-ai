@model TabulariusAI.Web.Models.SaftSalesInvoiceDetailViewModel
@using System.Globalization
@{ ViewData["Title"] = Model.Invoice.InvoiceNo; var invoice = Model.Invoice; var source = Model.Source.SelectedImport; var pt = CultureInfo.GetCultureInfo("pt-PT"); }
<partial name="_SaftSourceSelector" model="Model.Source" />
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Documento de vendas</p><h1>@invoice.InvoiceNo</h1><p class="lead">@invoice.InvoiceType · @invoice.InvoiceDate.ToString("dd/MM/yyyy") · @(invoice.CustomerId ?? "sem cliente associado")</p></div><a class="btn btn-secondary" asp-action="SalesInvoices" asp-route-id="@source.DossierId" asp-route-importId="@source.Id">Voltar aos documentos</a></section>
<section class="dashboard-kpis"><article><span class="kpi-icon">NT</span><div><small>Total líquido</small><strong>@invoice.NetTotal.ToString("N2",pt) €</strong></div></article><article><span class="kpi-icon">TX</span><div><small>IVA</small><strong>@invoice.TaxPayable.ToString("N2",pt) €</strong></div></article><article><span class="kpi-icon">€</span><div><small>Total bruto</small><strong>@invoice.GrossTotal.ToString("N2",pt) €</strong></div></article></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Informação do documento</p><h2>Detalhes</h2></div></div><div class="table-wrap"><table><thead><tr><th>Estado</th><th>Utilizador</th><th>Cliente</th><th>Tipo</th><th>Data</th></tr></thead><tbody><tr><td>@(string.IsNullOrWhiteSpace(invoice.InvoiceStatus) ? "—" : invoice.InvoiceStatus)</td><td>@invoice.SourceId</td><td>@(invoice.CustomerId ?? "—")</td><td>@invoice.InvoiceType</td><td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td></tr></tbody></table></div></section>
<section class="list-workspace"><div class="card-header"><div><p class="section-kicker">Linhas SAF-T</p><h2>Itens do documento</h2><p>@invoice.Lines.Count linhas persistidas a partir do SAF-T (PT).</p></div></div><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Produto</th><th>Descrição</th><th class="number-cell">Quantidade</th><th>Unidade</th><th class="number-cell">Preço unit.</th><th>Imposto</th><th class="number-cell">Valor</th></tr></thead><tbody>@foreach (var line in invoice.Lines.OrderBy(item => item.LineNumber)) { <tr><td>@line.LineNumber</td><td><strong>@line.ProductCode</strong></td><td>@line.ProductDescription</td><td class="number-cell">@line.Quantity.ToString("N2",pt)</td><td>@line.UnitOfMeasure</td><td class="number-cell">@line.UnitPrice.ToString("N2",pt)</td><td>@(line.TaxPercentage.HasValue ? $"{line.TaxType} {line.TaxPercentage.Value.ToString("N2",pt)}%" : line.TaxType ?? "—")</td><td class="number-cell"><strong>@line.LineAmount.ToString("N2",pt)</strong></td></tr> }</tbody></table></div></section>
