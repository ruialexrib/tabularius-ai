@model TabulariusAI.Web.Models.SaftSalesInvoiceDetailViewModel
@{ ViewData["Title"] = Model.Invoice.InvoiceNo; var invoice = Model.Invoice; var source = Model.Source.SelectedImport; }
<partial name="_SaftSourceSelector" model="Model.Source" />
<section class="page-header"><div><p class="eyebrow">Documento de vendas</p><h1>@invoice.InvoiceNo</h1><p class="lead">Detalhe preservado da fonte SAF-T (PT) selecionada.</p></div><a class="btn btn-secondary" asp-action="SalesInvoices" asp-route-id="@source.DossierId" asp-route-importId="@source.Id">Voltar aos documentos</a></section>
<section class="metrics-grid"><article class="metric-card"><span>Data</span><strong>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</strong></article><article class="metric-card"><span>Tipo</span><strong>@invoice.InvoiceType</strong></article><article class="metric-card"><span>Cliente</span><strong>@(invoice.CustomerId ?? "—")</strong></article><article class="metric-card"><span>Total</span><strong>@invoice.GrossTotal.ToString("N2")</strong></article></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Totais do documento</p><h2>Resumo</h2></div></div><div class="table-wrap"><table><thead><tr><th>Estado</th><th>Utilizador</th><th class="number-cell">Líquido</th><th class="number-cell">IVA</th><th class="number-cell">Total</th></tr></thead><tbody><tr><td>@(string.IsNullOrWhiteSpace(invoice.InvoiceStatus) ? "—" : invoice.InvoiceStatus)</td><td>@invoice.SourceId</td><td class="number-cell">@invoice.NetTotal.ToString("N2")</td><td class="number-cell">@invoice.TaxPayable.ToString("N2")</td><td class="number-cell"><strong>@invoice.GrossTotal.ToString("N2")</strong></td></tr></tbody></table></div></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Linhas SAF-T</p><h2>Itens do documento</h2></div></div><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Produto</th><th>Descrição</th><th class="number-cell">Quantidade</th><th>Unidade</th><th class="number-cell">Preço unit.</th><th>Imposto</th><th class="number-cell">Valor</th></tr></thead><tbody>@foreach (var line in invoice.Lines.OrderBy(item => item.LineNumber)) { <tr><td>@line.LineNumber</td><td>@line.ProductCode</td><td>@line.ProductDescription</td><td class="number-cell">@line.Quantity.ToString("N2")</td><td>@line.UnitOfMeasure</td><td class="number-cell">@line.UnitPrice.ToString("N2")</td><td>@(line.TaxPercentage.HasValue ? $"{line.TaxType} {line.TaxPercentage:N2}%" : line.TaxType ?? "—")</td><td class="number-cell"><strong>@line.LineAmount.ToString("N2")</strong></td></tr> }</tbody></table></div></section>
