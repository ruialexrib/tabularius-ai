@model TabulariusAI.Web.Models.VatAnalysisViewModel
@{ViewData["Title"]="Análise de IVA";var s=Model.Source;var hasFilters=!string.IsNullOrWhiteSpace(Model.Search)||!string.IsNullOrWhiteSpace(Model.InvoiceType)||Model.TaxPercentage.HasValue||Model.DateFrom.HasValue||Model.DateTo.HasValue;}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica</p><h1>Análise de IVA</h1><p class="lead">Resumo líquido do IVA por taxa e documento, considerando movimentos de sinal contrário.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@s.SelectedImport.DossierId">Voltar ao dossier</a></section>
<partial name="_SaftSourceSelector" model="s" />
<section class="analytics-kpis" style="margin-top:24px"><article><small>Base tributável líquida</small><strong>@Model.TotalTaxableBase.ToString("N2") €</strong><span>efeito líquido dos documentos</span></article><article><small>IVA líquido</small><strong>@Model.TotalVat.ToString("N2") €</strong><span>calculado pelas taxas das linhas</span></article><article><small>Total líquido</small><strong>@Model.TotalGross.ToString("N2") €</strong><span>base tributável + IVA</span></article><article><small>Documentos / taxa</small><strong>@Model.Documents.Count.ToString("N0")</strong><span>combinações documento e taxa</span></article></section>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Resumo fiscal</p><h2>IVA por taxa</h2><p>Valores líquidos: documentos com movimentos de sentido contrário reduzem ou anulam o respetivo efeito fiscal.</p></div></div>@if(Model.Rates.Count==0){<p class="empty-row">Não existem linhas de documentos de vendas com informação suficiente para esta análise.</p>}else{<div class="table-wrap"><table><thead><tr><th>Taxa</th><th class="text-end">Base tributável</th><th class="text-end">IVA</th><th class="text-end">Total</th><th class="text-end">Documentos</th></tr></thead><tbody>@foreach(var row in Model.Rates){<tr><td><strong>@(row.TaxPercentage.HasValue?$"{row.TaxPercentage:0.##}%":"Sem taxa")</strong></td><td class="text-end">@row.TaxableBase.ToString("N2") €</td><td class="text-end">@row.VatAmount.ToString("N2") €</td><td class="text-end"><strong>@row.GrossTotal.ToString("N2") €</strong></td><td class="text-end">@row.DocumentCount</td></tr>}</tbody></table></div>}</section>
<section class="panel list-workspace" style="margin-top:16px"><div class="card-header"><div><p class="section-kicker">Rastreabilidade</p><h2>Efeito por documento</h2><p>Decomposição por documento e taxa de IVA, preservando o sinal dos movimentos SAF-T (PT).</p></div></div><div class="list-toolbar"><form method="get" asp-action="VatAnalysis" class="list-filter-form"><input type="hidden" name="id" value="@s.SelectedImport.DossierId"/><input type="hidden" name="importId" value="@s.SelectedImport.Id"/><div class="list-search"><label for="vatSearch">Pesquisar</label><input id="vatSearch" name="search" value="@Model.Search" placeholder="Documento ou cliente" /></div><div class="list-page-size"><label for="vatType">Tipo</label><select id="vatType" name="invoiceType"><option value="">Todos</option>@foreach(var type in Model.InvoiceTypes){<option value="@type" selected="@(type==Model.InvoiceType)">@type</option>}</select></div><div class="list-page-size"><label for="vatRate">Taxa</label><select id="vatRate" name="taxPercentage"><option value="">Todas</option>@foreach(var rate in Model.TaxPercentages){<option value="@rate" selected="@(rate==Model.TaxPercentage)">@(rate.HasValue?$"{rate:0.##}%":"Sem taxa")</option>}</select></div><div class="list-page-size" style="min-width:132px"><label for="vatDateFrom">De</label><input id="vatDateFrom" type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" style="width:132px;min-width:132px" /></div><div class="list-page-size" style="min-width:132px"><label for="vatDateTo">Até</label><input id="vatDateTo" type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" style="width:132px;min-width:132px" /></div><button class="btn btn-primary">Filtrar</button>@if(hasFilters){<a class="btn btn-secondary" asp-action="VatAnalysis" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Limpar</a>}</form><div class="list-count"><strong>@Model.Documents.Count</strong><span>registos encontrados</span></div></div>@if(Model.Documents.Count==0){<p class="empty-row">Não existem documentos para os filtros selecionados.</p>}else{<div class="table-wrap"><table><thead><tr><th>Documento</th><th>Data</th><th>Tipo</th><th>Cliente</th><th>Taxa</th><th class="text-end">Base</th><th class="text-end">IVA</th><th class="text-end" style="min-width:120px">Total</th></tr></thead><tbody>@foreach(var row in Model.Documents){<tr><td><strong>@row.InvoiceNo</strong></td><td>@row.Date.ToString("dd/MM/yyyy")</td><td>@row.InvoiceType</td><td>@(row.CustomerId??"—")</td><td>@(row.TaxPercentage.HasValue?$"{row.TaxPercentage:0.##}%":"—")</td><td class="text-end">@row.TaxableBase.ToString("N2") €</td><td class="text-end">@row.VatAmount.ToString("N2") €</td><td class="text-end" style="min-width:120px;white-space:nowrap"><strong>@row.GrossTotal.ToString("N2") €</strong></td></tr>}</tbody></table></div>}</section>
<partial name="_AiAnalyticalReport" model='new TabulariusAI.Web.Services.AI.AiAnalyticalReportRequest("vat-analysis","Análise de IVA",new { CurrencyCode="EUR",Model.TotalTaxableBase,Model.TotalVat,Model.TotalGross,Rates=Model.Rates,Documents=Model.Documents.Take(100) })'/>
