@model TabulariusAI.Web.Models.SaftListViewModel<TabulariusAI.Web.Data.Entities.SaftSalesInvoice>
@{ ViewData["Title"] = "Documentos de vendas"; var source = Model.Source.SelectedImport; var list = Model.List; }
<partial name="_SaftSourceSelector" model="Model.Source" />
<section class="page-header"><div><p class="eyebrow">Documentos SAF-T (PT)</p><h1>Documentos de vendas</h1><p class="lead">Faturas, faturas simplificadas, notas de crédito e restantes documentos de vendas da fonte selecionada.</p></div></section>
<section class="panel"><form method="get" class="filterbar"><input type="hidden" name="id" value="@source.DossierId" /><input type="hidden" name="importId" value="@source.Id" /><label>Pesquisar<input name="search" value="@list.Search" placeholder="Documento, tipo, cliente ou utilizador" /></label><button class="btn btn-secondary" type="submit">Pesquisar</button></form>
<div class="table-wrap"><table><thead><tr><th>Documento</th><th>Data</th><th>Tipo</th><th>Cliente</th><th>Estado</th><th class="number-cell">Líquido</th><th class="number-cell">IVA</th><th class="number-cell">Total</th></tr></thead><tbody>@if (list.Items.Count == 0) { <tr><td colspan="8" class="empty-row">Não existem documentos de vendas para esta fonte.</td></tr> } else { @foreach (var item in list.Items) { <tr><td><a asp-action="SalesInvoice" asp-route-id="@source.DossierId" asp-route-importId="@source.Id" asp-route-invoiceId="@item.Id"><strong>@item.InvoiceNo</strong></a></td><td>@item.InvoiceDate.ToString("dd/MM/yyyy")</td><td>@item.InvoiceType</td><td>@(item.CustomerId ?? "—")</td><td>@(string.IsNullOrWhiteSpace(item.InvoiceStatus) ? "—" : item.InvoiceStatus)</td><td class="number-cell">@item.NetTotal.ToString("N2")</td><td class="number-cell">@item.TaxPayable.ToString("N2")</td><td class="number-cell"><strong>@item.GrossTotal.ToString("N2")</strong></td></tr> } }</tbody></table></div>
<div class="list-footer"><span>A mostrar @list.FirstItem–@list.LastItem de @list.TotalItems</span><nav class="pagination"><a class="page-link @(list.HasPreviousPage ? "" : "disabled")" asp-action="SalesInvoices" asp-route-id="@source.DossierId" asp-route-importId="@source.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page - 1)">Anterior</a><span class="page-current">Página @list.Page de @list.TotalPages</span><a class="page-link @(list.HasNextPage ? "" : "disabled")" asp-action="SalesInvoices" asp-route-id="@source.DossierId" asp-route-importId="@source.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page + 1)">Seguinte</a></nav></div></section>
