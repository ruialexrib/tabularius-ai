@model TabulariusAI.Web.Models.SaftListViewModel<TabulariusAI.Web.Data.Entities.SaftTransaction>
@{ var import=Model.Source.SelectedImport; var list=Model.List; ViewData["Title"]=$"Lançamentos contabilísticos · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · GeneralLedgerEntries</p><h1>Lançamentos contabilísticos</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear. Consulte as transações contabilísticas e abra cada lançamento para analisar as respetivas linhas.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="list-workspace"><div class="list-toolbar"><form method="get" class="list-filter-form"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="list-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@list.Search" placeholder="Transação, descrição, diário, conta ou documento" /></div><div class="list-page-size"><label for="pageSize">Registos</label><select id="pageSize" name="pageSize"><option selected="@(list.PageSize==10)" value="10">10</option><option selected="@(list.PageSize==25)" value="25">25</option><option selected="@(list.PageSize==50)" value="50">50</option><option selected="@(list.PageSize==100)" value="100">100</option></select></div><button class="btn btn-primary">Filtrar</button>@if(!string.IsNullOrEmpty(list.Search)){<a class="btn btn-secondary" asp-action="AccountingEntries" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-pageSize="@list.PageSize">Limpar</a>}</form><div class="list-count"><strong>@list.TotalItems</strong><span>lançamentos encontrados</span></div></div>
<div class="table-wrap"><table><thead><tr><th>Data</th><th>Diário</th><th>Transação</th><th>Descrição</th><th>Período</th><th>Documento</th><th>Ações</th></tr></thead><tbody>@if(list.Items.Count==0){<tr><td colspan="7" class="empty-row">Não foram encontrados lançamentos contabilísticos para os filtros selecionados.</td></tr>}else{foreach(var item in list.Items){<tr><td>@item.TransactionDate.ToString("dd/MM/yyyy")</td><td><strong>@item.JournalId</strong><br/><small>@item.JournalDescription</small></td><td>@item.TransactionId</td><td>@item.Description</td><td>@item.Period</td><td>@(item.DocArchivalNumber ?? "—")</td><td><a class="btn-link" asp-action="AccountingEntry" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-transactionId="@item.Id">Ver linhas</a></td></tr>}}</tbody></table></div>
<div class="list-footer"><span>A mostrar @list.FirstItem–@list.LastItem de @list.TotalItems</span><nav class="pagination"><a class="page-link @(list.HasPreviousPage?"":"disabled")" asp-action="AccountingEntries" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page-1)">Anterior</a><span class="page-current">Página @list.Page de @list.TotalPages</span><a class="page-link @(list.HasNextPage?"":"disabled")" asp-action="AccountingEntries" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page+1)">Seguinte</a></nav></div></section>
