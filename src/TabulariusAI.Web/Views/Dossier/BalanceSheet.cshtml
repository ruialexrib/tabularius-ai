@model TabulariusAI.Web.Models.BalanceSheetViewModel
@{var import=Model.Source.SelectedImport;ViewData["Title"]=$"Balanço · {import.Dossier.AccountingEntity.Name}";}
<section class="page-header"><div><p class="eyebrow">Análise contabilística · SAF-T (PT)</p><h1>Balanço</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="balance-kpis"><article><span>Ativo</span><strong>@Model.TotalAssets.ToString("N2")</strong></article><article><span>Capital próprio</span><strong>@Model.TotalEquity.ToString("N2")</strong></article><article><span>Passivo</span><strong>@Model.TotalLiabilities.ToString("N2")</strong></article><article class="@(Model.IsBalanced?"balanced":"warning")"><span>Diferença</span><strong>@Model.Difference.ToString("N2")</strong><small>@(Model.IsBalanced?"Balanço equilibrado":"Requer análise")</small></article></section>
<section class="balance-card"><header><p class="section-kicker">Balanço sintético</p><h2>Posição financeira</h2><p>Construído a partir dos saldos finais das contas de movimento.</p></header><div class="balance-columns"><div><div class="balance-heading"><h3>Ativo</h3><strong>@Model.TotalAssets.ToString("N2")</strong></div><table><tbody>@foreach(var item in Model.Assets){<tr><td class="account">@item.AccountId</td><td>@item.Description</td><td class="numeric">@item.Amount.ToString("N2")</td></tr>}</tbody></table></div><div><div class="balance-heading"><h3>Capital próprio e Passivo</h3><strong>@((Model.TotalEquity+Model.TotalLiabilities).ToString("N2"))</strong></div><table><tbody>@foreach(var item in Model.Equity){<tr><td class="account">@item.AccountId</td><td>@item.Description <small>Capital próprio</small></td><td class="numeric">@item.Amount.ToString("N2")</td></tr>}@foreach(var item in Model.Liabilities){<tr><td class="account">@item.AccountId</td><td>@item.Description <small>Passivo</small></td><td class="numeric">@item.Amount.ToString("N2")</td></tr>}</tbody></table></div></div>@if(Model.Unclassified.Count>0){<div class="balance-unclassified"><strong>@Model.Unclassified.Count conta(s) não classificada(s)</strong><span>Estas contas foram excluídas do controlo de equilíbrio e devem ser revistas.</span>@foreach(var item in Model.Unclassified){<small>@item.AccountId · @item.Description · @item.Amount.ToString("N2")</small>}</div>}<footer><span>Ativo − Capital próprio − Passivo</span><strong>@Model.Difference.ToString("N2")</strong></footer></section>
<p class="balance-note">Versão sintética: a classificação usa a estrutura das contas SNC e o sinal do saldo. Não substitui uma Demonstração da Posição Financeira formal baseada na taxonomia contabilística completa.</p>
