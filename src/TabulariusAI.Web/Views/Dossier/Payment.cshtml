@model TabulariusAI.Web.Models.SaftPaymentDetailViewModel
@using System.Globalization
@{var p=Model.Payment;var import=Model.Source.SelectedImport;var pt=CultureInfo.GetCultureInfo("pt-PT");ViewData["Title"]=$"{p.PaymentRefNo} · Recibo";}
<partial name="_SaftSourceSelector" model="Model.Source" />
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Recibo</p><h1>@p.PaymentRefNo</h1><p class="lead">@p.PaymentType · @p.TransactionDate.ToString("dd/MM/yyyy") · @(p.CustomerId??"sem cliente associado")</p></div><a class="btn btn-secondary" asp-action="Payments" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Voltar aos recibos</a></section>
<section class="dashboard-kpis"><article><span class="kpi-icon">NT</span><div><small>Total líquido</small><strong>@p.NetTotal.ToString("N2",pt) €</strong></div></article><article><span class="kpi-icon">TX</span><div><small>Imposto</small><strong>@p.TaxPayable.ToString("N2",pt) €</strong></div></article><article><span class="kpi-icon">€</span><div><small>Total bruto</small><strong>@p.GrossTotal.ToString("N2",pt) €</strong></div></article></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Informação do recibo</p><h2>Detalhes</h2></div></div><dl class="summary-grid"><div><dt>Estado</dt><dd>@(string.IsNullOrWhiteSpace(p.PaymentStatus)?"—":p.PaymentStatus)</dd></div><div><dt>Cliente</dt><dd>@(p.CustomerId??"—")</dd></div><div><dt>Utilizador</dt><dd>@p.SourceId</dd></div><div><dt>Entrada no sistema</dt><dd>@(p.SystemEntryDate?.ToString("dd/MM/yyyy HH:mm")??"—")</dd></div></dl></section>
<section class="list-workspace"><div class="card-header"><div><p class="section-kicker">Linhas SAF-T</p><h2>Documentos liquidados</h2><p>@p.Lines.Count linhas persistidas a partir do SAF-T (PT).</p></div></div><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Documento origem</th><th>Data</th><th>Descrição</th><th class="number-cell">Débito</th><th class="number-cell">Crédito</th></tr></thead><tbody>@foreach(var line in p.Lines.OrderBy(x=>x.LineNumber)){<tr><td>@line.LineNumber</td><td><strong>@(line.OriginatingOn??"—")</strong></td><td>@(line.InvoiceDate?.ToString("dd/MM/yyyy")??"—")</td><td>@(line.Description??"—")</td><td class="number-cell">@line.DebitAmount.ToString("N2",pt)</td><td class="number-cell">@line.CreditAmount.ToString("N2",pt)</td></tr>}</tbody></table></div></section>
