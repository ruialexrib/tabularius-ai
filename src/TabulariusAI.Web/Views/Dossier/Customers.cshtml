@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{ var import = Model.SelectedImport; ViewData["Title"] = $"Clientes · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · MasterFiles</p><h1>Clientes</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model" /></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">@import.Customers.Count registos</p><h2>Ficha de clientes</h2></div></div><div class="table-wrap"><table><thead><tr><th>ID cliente</th><th>Nome</th><th>NIF</th><th>Conta</th></tr></thead><tbody>@if (import.Customers.Count == 0) { <tr><td colspan="4" class="empty-row">Esta importação não contém clientes persistidos. Volte a importar o SAF-T (PT).</td></tr> } else { foreach (var item in import.Customers.OrderBy(item => item.CompanyName)) { <tr><td><strong>@item.CustomerId</strong></td><td>@item.CompanyName</td><td>@item.TaxId</td><td>@item.AccountId</td></tr> } }</tbody></table></div></section>
