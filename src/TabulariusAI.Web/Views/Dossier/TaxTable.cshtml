@model TabulariusAI.Web.Models.SaftListViewModel<TabulariusAI.Web.Data.Entities.SaftTaxEntry>
@{ var import=Model.Source.SelectedImport; var list=Model.List; ViewData["Title"]=$"Tabela de impostos · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · MasterFiles</p><h1>Tabela de impostos</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section><section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="list-workspace"><div class="list-toolbar"><form method="get" class="list-filter-form"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="list-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@list.Search" placeholder="Tipo, região, código ou descrição" /></div><div class="list-page-size"><label for="pageSize">Registos</label><select id="pageSize" name="pageSize"><option selected="@(list.PageSize==10)" value="10">10</option><option selected="@(list.PageSize==25)" value="25">25</option><option selected="@(list.PageSize==50)" value="50">50</option><option selected="@(list.PageSize==100)" value="100">100</option></select></div><button class="btn btn-primary">Filtrar</button>@if(!string.IsNullOrEmpty(list.Search)){<a class="btn btn-secondary" asp-action="TaxTable" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-pageSize="@list.PageSize">Limpar</a>}</form><div class="list-count"><strong>@list.TotalItems</strong><span>registos encontrados</span></div></div><div class="table-wrap"><table><thead><tr><th>Tipo</th><th>Região</th><th>Código</th><th>Descrição</th><th>Taxa</th><th>Montante</th><th>Validade</th></tr></thead><tbody>@if(list.Items.Count==0){<tr><td colspan="7" class="empty-row">Não foram encontrados impostos para os filtros selecionados.</td></tr>}else{foreach(var item in list.Items){<tr><td><strong>@item.TaxType</strong></td><td>@item.TaxCountryRegion</td><td>@item.TaxCode</td><td>@item.Description</td><td>@(item.TaxPercentage.HasValue ? $"{item.TaxPercentage.Value:0.####}%" : "—")</td><td>@(item.TaxAmount.HasValue ? item.TaxAmount.Value.ToString("N2") : "—")</td><td>@(item.TaxExpirationDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>}}</tbody></table></div><div class="list-footer"><span>A mostrar @list.FirstItem–@list.LastItem de @list.TotalItems</span><nav class="pagination"><a class="page-link @(list.HasPreviousPage?"":"disabled")" asp-action="TaxTable" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page-1)">Anterior</a><span class="page-current">Página @list.Page de @list.TotalPages</span><a class="page-link @(list.HasNextPage?"":"disabled")" asp-action="TaxTable" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page+1)">Seguinte</a></nav></div></section>
