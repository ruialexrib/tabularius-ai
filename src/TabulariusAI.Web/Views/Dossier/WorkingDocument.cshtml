@model TabulariusAI.Web.Models.SaftWorkingDocumentDetailViewModel
@using System.Globalization
@{var d=Model.Document;var import=Model.Source.SelectedImport;ViewData["Title"]=$"{d.DocumentNumber} · Documento de conferência";var pt=CultureInfo.GetCultureInfo("pt-PT");}
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Documento de conferência</p><h1>@d.DocumentNumber</h1><p class="lead">@d.WorkType · @d.WorkDate.ToString("dd/MM/yyyy") · @(d.CustomerId??"sem cliente associado")</p></div><a class="btn btn-secondary" asp-action="WorkingDocuments" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Voltar à lista</a></section>
<section class="dashboard-kpis"><article><span class="kpi-icon">NT</span><div><small>Total líquido</small><strong>@d.NetTotal.ToString("N2",pt) €</strong></div></article><article><span class="kpi-icon">TX</span><div><small>Imposto</small><strong>@d.TaxPayable.ToString("N2",pt) €</strong></div></article><article><span class="kpi-icon">€</span><div><small>Total bruto</small><strong>@d.GrossTotal.ToString("N2",pt) €</strong></div></article></section>
<section class="list-workspace"><div class="card-header"><div><p class="section-kicker">Detalhe</p><h2>Linhas do documento</h2><p>@d.Lines.Count linhas persistidas a partir do SAF-T (PT).</p></div></div><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Produto</th><th>Descrição</th><th>Quantidade</th><th>Preço unitário</th><th>Imposto</th><th>Valor</th></tr></thead><tbody>@foreach(var line in d.Lines.OrderBy(x=>x.LineNumber)){<tr><td>@line.LineNumber</td><td><strong>@line.ProductCode</strong></td><td>@line.ProductDescription</td><td>@line.Quantity.ToString("N4",pt) @line.UnitOfMeasure</td><td>@line.UnitPrice.ToString("N4",pt) €</td><td>@(line.TaxCode??"—") @(line.TaxPercentage.HasValue?$"· {line.TaxPercentage.Value.ToString("N2",pt)}%":"")</td><td>@((line.CreditAmount-line.DebitAmount).ToString("N2",pt)) €</td></tr>}</tbody></table></div></section>
