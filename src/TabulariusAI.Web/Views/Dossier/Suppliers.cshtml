@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{ var import = Model.SelectedImport; ViewData["Title"] = $"Fornecedores · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · MasterFiles</p><h1>Fornecedores</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel source-panel"><div class="card-header"><div><p class="section-kicker">Fonte SAF-T (PT)</p><h2>@import.OriginalFileName</h2><p>Período: @(import.StartDate?.ToString("dd/MM/yyyy") ?? "—") a @(import.EndDate?.ToString("dd/MM/yyyy") ?? "—")</p></div></div><form method="get" asp-action="Suppliers" class="source-selector"><input type="hidden" name="id" value="@import.DossierId" /><label for="importId">Importação apresentada</label><select id="importId" name="importId" onchange="this.form.submit()">@foreach (var source in Model.AvailableImports) { <option value="@source.Id" selected="@(source.Id == import.Id)">@source.OriginalFileName · @(source.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(source.EndDate?.ToString("dd/MM/yyyy") ?? "—")</option> }</select><noscript><button class="btn btn-primary" type="submit">Aplicar</button></noscript></form><nav class="workspace-links"><a asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Contas</a><a asp-action="Customers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Clientes</a><a asp-action="Suppliers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Fornecedores</a></nav></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">@import.Suppliers.Count registos</p><h2>Ficha de fornecedores</h2></div></div><div class="table-wrap"><table><thead><tr><th>ID fornecedor</th><th>Nome</th><th>NIF</th><th>Conta</th></tr></thead><tbody>@if (import.Suppliers.Count == 0) { <tr><td colspan="4" class="empty-row">Esta importação não contém fornecedores persistidos. Volte a importar o SAF-T (PT).</td></tr> } else { foreach (var item in import.Suppliers.OrderBy(item => item.CompanyName)) { <tr><td><strong>@item.SupplierId</strong></td><td>@item.CompanyName</td><td>@item.TaxId</td><td>@item.AccountId</td></tr> } }</tbody></table></div></section>
