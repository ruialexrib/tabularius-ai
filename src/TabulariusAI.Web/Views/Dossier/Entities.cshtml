@model IReadOnlyCollection<TabulariusAI.Web.Data.Entities.AccountingEntity>
@{ ViewData["Title"] = "Entidades e exercícios"; }
<section class="page-header"><div><p class="eyebrow">Dossiers contabilísticos</p><h1>Entidades e exercícios</h1><p class="lead">Selecione uma entidade para escolher o exercício e entrar no respetivo espaço de trabalho.</p></div><a class="btn btn-primary" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a></section>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="status-message status-success">@successMessage</div> }
<section class="panel">@if (Model.Count == 0) { <div class="empty-dashboard"><h2>Ainda não existem entidades</h2><p>Importe o primeiro ficheiro SAF-T (PT). A entidade e o exercício serão criados a partir dos dados do ficheiro.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Entidade</th><th>NIF</th><th>Exercícios</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong></td><td>@item.TaxRegistrationNumber</td><td>@item.Dossiers.Count</td><td><div class="row-actions"><a asp-controller="Dossier" asp-action="Entity" asp-route-id="@item.Id">Abrir entidade</a><form asp-action="DeleteEntity" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar a entidade «@item.Name»? Todos os dossiers, importações e dados associados serão eliminados permanentemente.');"><button type="submit" class="btn-link-danger">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</section>
