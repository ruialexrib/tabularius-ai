@model IReadOnlyCollection<TabulariusAI.Web.Data.Entities.AccountingEntity>
@{
    ViewData["Title"] = "Entidades";
}

<section class="hero">
    <p class="eyebrow">Dossier</p>
    <h1>Entidades</h1>
    <p class="lead">Selecione uma empresa para consultar os respetivos exercícios e continuar a análise contabilística.</p>
</section>

<section class="panel">
    @if (Model.Count == 0)
    {
        <p>Ainda não existem entidades. Importe um ficheiro SAF-T (PT) a partir do Dashboard.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Entidade</th><th>NIF</th><th>Dossiers</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.TaxRegistrationNumber</td>
                        <td>@item.Dossiers.Count</td>
                        <td><a asp-controller="Dossier" asp-action="Entity" asp-route-id="@item.Id">Abrir entidade</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
