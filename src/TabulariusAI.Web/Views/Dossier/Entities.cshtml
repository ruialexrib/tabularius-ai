@model TabulariusAI.Web.Models.PagedListViewModel<TabulariusAI.Web.Data.Entities.AccountingEntity>
@{ ViewData["Title"]="Entidades e exercícios"; var list=Model; }
<section class="page-header"><div><p class="eyebrow">Dossiers contabilísticos</p><h1>Entidades e exercícios</h1><p class="lead">Selecione uma entidade para escolher o exercício e entrar no respetivo espaço de trabalho.</p></div><div class="page-header-actions" style="gap:12px"><a class="btn btn-secondary" asp-action="RestoreBackup">Restaurar backup</a><a class="btn btn-primary" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a></div></section>
@if(TempData["SuccessMessage"] is string successMessage){<div class="status-message status-success">@successMessage</div>}
<section class="list-workspace"><div class="list-toolbar"><form method="get" class="list-filter-form"><div class="list-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@list.Search" placeholder="Nome da entidade ou NIF" /></div><div class="list-page-size"><label for="pageSize">Registos</label><select id="pageSize" name="pageSize"><option selected="@(list.PageSize==10)" value="10">10</option><option selected="@(list.PageSize==25)" value="25">25</option><option selected="@(list.PageSize==50)" value="50">50</option><option selected="@(list.PageSize==100)" value="100">100</option></select></div><button class="btn btn-primary">Filtrar</button>@if(!string.IsNullOrEmpty(list.Search)){<a class="btn btn-secondary" asp-action="Entities" asp-route-pageSize="@list.PageSize">Limpar</a>}</form><div class="list-count"><strong>@list.TotalItems</strong><span>entidades encontradas</span></div></div>
@if(list.TotalItems==0 && string.IsNullOrEmpty(list.Search)){<div class="empty-dashboard"><h2>Ainda não existem entidades</h2><p>Importe o primeiro ficheiro SAF-T (PT) ou restaure um dossier a partir de um backup JSON.</p><div class="page-header-actions" style="gap:12px"><a class="btn btn-secondary" asp-action="RestoreBackup">Restaurar backup</a><a class="btn btn-primary" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a></div></div>}else{<div class="table-wrap"><table><thead><tr><th>Entidade</th><th>NIF</th><th>Exercícios</th><th>Ações</th></tr></thead><tbody>@if(list.Items.Count==0){<tr><td colspan="4" class="empty-row">Não foram encontradas entidades para os filtros selecionados.</td></tr>}else{foreach(var item in list.Items){<tr><td><strong>@item.Name</strong></td><td>@item.TaxRegistrationNumber</td><td>@item.Dossiers.Count</td><td><div class="row-actions"><a asp-action="Entity" asp-route-id="@item.Id">Abrir entidade</a><form asp-action="DeleteEntity" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar a entidade «@item.Name»? Todos os dossiers, importações e dados associados serão eliminados permanentemente.');"><button type="submit" class="btn-link-danger">Eliminar</button></form></div></td></tr>}}</tbody></table></div><div class="list-footer"><span>A mostrar @list.FirstItem–@list.LastItem de @list.TotalItems</span><nav class="pagination"><a class="page-link @(list.HasPreviousPage?"":"disabled")" asp-action="Entities" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page-1)">Anterior</a><span class="page-current">Página @list.Page de @list.TotalPages</span><a class="page-link @(list.HasNextPage?"":"disabled")" asp-action="Entities" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page+1)">Seguinte</a></nav></div>}</section>
