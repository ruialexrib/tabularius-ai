@model IReadOnlyCollection<TabulariusAI.Web.Data.Entities.AccountingEntity>
@{
    ViewData["Title"] = "Entidades";
}

<section class="hero">
    <p class="eyebrow">Dossier</p>
    <h1>Entidades</h1>
    <p class="lead">Empresas e organizações identificadas a partir das importações SAF-T (PT).</p>
</section>

<section class="panel">
    @if (Model.Count == 0)
    {
        <p>Ainda não existem entidades. Importe um ficheiro SAF-T (PT) a partir do Dashboard.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Entidade</th><th>NIF</th><th>Dossiers</th><th>Criada em</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr><td><strong>@item.Name</strong></td><td>@item.TaxRegistrationNumber</td><td>@item.Dossiers.Count</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
