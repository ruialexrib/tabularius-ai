@model TabulariusAI.Web.Models.SaftListViewModel<TabulariusAI.Web.Data.Entities.SaftPayment>
@using System.Globalization
@{var source=Model.Source.SelectedImport;var pt=CultureInfo.GetCultureInfo("pt-PT");ViewData["Title"]="Recibos e pagamentos";var total=Model.List.Items.Sum(x=>x.GrossTotal);}
<partial name="_SaftSourceSelector" model="Model.Source" />
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Documentos fonte</p><h1>Recibos e pagamentos</h1><p class="lead">Recibos persistidos da fonte SAF-T (PT) selecionada.</p></div></section>
<section class="dashboard-kpis"><article><span class="kpi-icon">RC</span><div><small>Registos nesta página</small><strong>@Model.List.Items.Count</strong></div></article><article><span class="kpi-icon">Σ</span><div><small>Total nesta página</small><strong>@total.ToString("N2",pt) €</strong></div></article></section>
<section class="list-workspace"><div class="card-header"><div><p class="section-kicker">Documentos</p><h2>Recibos emitidos</h2></div><form method="get" class="filterbar"><input type="hidden" name="id" value="@source.DossierId"/><input type="hidden" name="importId" value="@source.Id"/><input name="search" value="@Model.List.Search" placeholder="Pesquisar recibo, tipo ou cliente"/><button class="btn btn-secondary" type="submit">Pesquisar</button></form></div><div class="table-wrap"><table><thead><tr><th>Referência</th><th>Data</th><th>Tipo</th><th>Cliente</th><th>Estado</th><th class="number-cell">Total</th><th></th></tr></thead><tbody>@foreach(var item in Model.List.Items){<tr><td><strong>@item.PaymentRefNo</strong></td><td>@item.TransactionDate.ToString("dd/MM/yyyy")</td><td>@item.PaymentType</td><td>@(item.CustomerId??"—")</td><td>@(string.IsNullOrWhiteSpace(item.PaymentStatus)?"—":item.PaymentStatus)</td><td class="number-cell"><strong>@item.GrossTotal.ToString("N2",pt) €</strong></td><td><a class="btn btn-secondary" asp-action="Payment" asp-route-id="@source.DossierId" asp-route-importId="@source.Id" asp-route-paymentId="@item.Id">Ver linhas</a></td></tr>}</tbody></table></div><partial name="_Pagination" model="Model.List" /></section>
