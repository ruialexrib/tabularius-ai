@model TabulariusAI.Web.Models.AnalyticsOverviewViewModel
@{ViewData["Title"]="Visão geral analítica";var s=Model.Source;var max=Model.Monthly.Count==0?1:Math.Max(1,Model.Monthly.Max(x=>Math.Max(x.Debit,x.Credit)));}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica</p><h1>Visão geral</h1><p class="lead">Leitura determinística da atividade contabilística da fonte SAF-T (PT) selecionada.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@s.SelectedImport.DossierId">Voltar ao dossier</a></section>
<partial name="_SaftSourceSelector" model="s" />
<nav class="analytics-tabs"><a class="active" asp-action="Analytics" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Visão geral</a><a asp-action="Anomalies" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Anomalias</a><a asp-action="AccountAnalysis" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Análise de contas</a></nav>
<section class="analytics-kpis"><article><small>Lançamentos</small><strong>@Model.TransactionCount.ToString("N0")</strong><span>transações contabilísticas</span></article><article><small>Movimentos a débito</small><strong>@Model.TotalDebit.ToString("N2") €</strong><span>valor determinístico</span></article><article><small>Movimentos a crédito</small><strong>@Model.TotalCredit.ToString("N2") €</strong><span>valor determinístico</span></article><article class="@(Model.AnomalyCount>0?"analytics-kpi-alert":"")"><small>Anomalias</small><strong>@Model.AnomalyCount</strong><span>@(Model.AnomalyCount>0?"situações a analisar":"sem alertas nas regras atuais")</span></article></section>
<div class="analytics-grid"><section class="panel analytics-panel"><div class="card-header"><div><p class="section-kicker">Evolução</p><h2>Atividade mensal</h2><p>Débitos e créditos por mês contabilístico.</p></div></div><div class="analytics-bars">@foreach(var m in Model.Monthly){<div class="analytics-month"><span>@System.Globalization.CultureInfo.GetCultureInfo("pt-PT").DateTimeFormat.GetAbbreviatedMonthName(m.Month)</span><div class="analytics-bar-pair"><i class="debit" style="height:@((double)(m.Debit/max)*100)%" title="Débito: @m.Debit.ToString("N2") €"></i><i class="credit" style="height:@((double)(m.Credit/max)*100)%" title="Crédito: @m.Credit.ToString("N2") €"></i></div></div>}</div><div class="analytics-legend"><span><i class="debit"></i>Débito</span><span><i class="credit"></i>Crédito</span></div></section><section class="panel analytics-panel"><div class="card-header"><div><p class="section-kicker">Concentração</p><h2>Contas com maior movimento</h2><p>Ordenadas pelo volume total de débitos e créditos.</p></div><a asp-action="AccountAnalysis" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Ver todas →</a></div><div class="analytics-account-list">@foreach(var row in Model.TopAccounts){<div><span><strong>@row.AccountId</strong><small>@row.Description</small></span><b>@((row.Debit+row.Credit).ToString("N2")) €</b></div>}</div></section></div>
