@model TabulariusAI.Web.Models.TrialBalanceViewModel
@{ var import = Model.Source.SelectedImport; ViewData["Title"] = $"Balancete · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">Análise contabilística · SAF-T (PT)</p><h1>Balancete</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="trial-balance-kpis" aria-label="Resumo do balancete"><article><span>Débitos</span><strong>@Model.TotalDebitMovements.ToString("N2")</strong><small>Movimentos do período</small></article><article><span>Créditos</span><strong>@Model.TotalCreditMovements.ToString("N2")</strong><small>Movimentos do período</small></article><article class="@(Model.MovementDifference == 0m ? "is-balanced" : "is-warning")"><span>Diferença</span><strong>@Model.MovementDifference.ToString("N2")</strong><small>@(Model.MovementDifference == 0m ? "Débitos = Créditos" : "Requer verificação")</small></article><article><span>Contas</span><strong>@Model.Rows.Count</strong><small>Apresentadas</small></article></section>
<section class="trial-balance-card">
<header class="trial-balance-card-header"><div><p class="section-kicker">Mapa contabilístico</p><h2>Saldos e movimentos</h2></div><form method="get" class="trial-balance-filters"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="trial-balance-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@Model.Search" placeholder="Conta ou descrição" /></div><label class="trial-balance-switch"><input type="checkbox" name="includeZeroAccounts" value="true" checked="@Model.IncludeZeroAccounts"/><span class="switch-track" aria-hidden="true"><span></span></span><span>Contas sem valores</span></label><button class="btn btn-primary" type="submit">Filtrar</button>@if(!string.IsNullOrEmpty(Model.Search) || Model.IncludeZeroAccounts){<a class="btn btn-secondary" asp-action="TrialBalance" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Limpar</a>}</form></header>
<div class="trial-balance-table-scroll"><table class="trial-balance-table"><colgroup><col class="col-account"/><col class="col-description"/><col span="6" class="col-amount"/><col class="col-control"/></colgroup><thead><tr class="group-row"><th rowspan="2">Conta</th><th rowspan="2">Descrição</th><th colspan="2">Saldo inicial</th><th colspan="2" class="group-movements">Movimentos</th><th colspan="2">Saldo final</th><th rowspan="2" class="center">Controlo</th></tr><tr class="sub-row"><th>Débito</th><th>Crédito</th><th class="movement-cell">Débito</th><th class="movement-cell">Crédito</th><th>Débito</th><th>Crédito</th></tr></thead><tbody>
@if(Model.Rows.Count==0){<tr><td colspan="9" class="trial-balance-empty">Não existem contas para os filtros selecionados.</td></tr>}else{foreach(var item in Model.Rows){<tr><td class="account"><strong>@item.AccountId</strong></td><td class="description" title="@item.Description">@item.Description</td><td class="amount muted">@(item.OpeningDebit == 0m ? "—" : item.OpeningDebit.ToString("N2"))</td><td class="amount muted">@(item.OpeningCredit == 0m ? "—" : item.OpeningCredit.ToString("N2"))</td><td class="amount movement-cell">@(item.DebitMovements == 0m ? "—" : item.DebitMovements.ToString("N2"))</td><td class="amount movement-cell">@(item.CreditMovements == 0m ? "—" : item.CreditMovements.ToString("N2"))</td><td class="amount closing">@(item.ClosingDebit == 0m ? "—" : item.ClosingDebit.ToString("N2"))</td><td class="amount closing">@(item.ClosingCredit == 0m ? "—" : item.ClosingCredit.ToString("N2"))</td><td class="center"><span class="trial-balance-status @(item.HasClosingDifference ? "status-difference" : "status-ok")">@(item.HasClosingDifference ? "Diferença" : "OK")</span></td></tr>}}
</tbody>@if(Model.Rows.Count>0){<tfoot><tr><th colspan="2">Totais</th><th class="amount">@Model.TotalOpeningDebit.ToString("N2")</th><th class="amount">@Model.TotalOpeningCredit.ToString("N2")</th><th class="amount movement-cell">@Model.TotalDebitMovements.ToString("N2")</th><th class="amount movement-cell">@Model.TotalCreditMovements.ToString("N2")</th><th class="amount">@Model.TotalClosingDebit.ToString("N2")</th><th class="amount">@Model.TotalClosingCredit.ToString("N2")</th><th></th></tr></tfoot>}</table></div>
<footer class="trial-balance-footer"><span class="trial-balance-info-icon" aria-hidden="true">i</span><p><strong>Controlo contabilístico.</strong> O saldo final é calculado a partir do saldo inicial e dos movimentos e comparado com o saldo final declarado na mesma fonte SAF-T (PT).</p></footer>
</section>
