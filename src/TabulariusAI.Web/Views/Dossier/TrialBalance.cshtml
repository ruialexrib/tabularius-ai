@model TabulariusAI.Web.Models.TrialBalanceViewModel
@{ var import = Model.Source.SelectedImport; ViewData["Title"] = $"Balancete · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">Análise contabilística · SAF-T (PT)</p><h1>Balancete</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear. Saldos iniciais, movimentos a débito e crédito e saldos finais calculados para a fonte selecionada.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="list-workspace">
<div class="list-toolbar"><form method="get" class="list-filter-form"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="list-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@Model.Search" placeholder="Conta ou descrição" /></div><label><input type="checkbox" name="includeZeroAccounts" value="true" checked="@Model.IncludeZeroAccounts" /> Incluir contas sem valores</label><button class="btn btn-primary">Filtrar</button>@if(!string.IsNullOrEmpty(Model.Search) || Model.IncludeZeroAccounts){<a class="btn btn-secondary" asp-action="TrialBalance" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Limpar</a>}</form><div class="list-count"><strong>@Model.Rows.Count</strong><span>contas no balancete</span></div></div>
<div class="table-wrap"><table><thead><tr><th rowspan="2">Conta</th><th rowspan="2">Descrição</th><th colspan="2">Saldo inicial</th><th colspan="2">Movimentos</th><th colspan="2">Saldo final</th><th rowspan="2">Controlo</th></tr><tr><th>Débito</th><th>Crédito</th><th>Débito</th><th>Crédito</th><th>Débito</th><th>Crédito</th></tr></thead><tbody>
@if(Model.Rows.Count==0){<tr><td colspan="9" class="empty-row">Não existem contas para os filtros selecionados.</td></tr>}else{foreach(var item in Model.Rows){<tr><td><strong>@item.AccountId</strong></td><td>@item.Description</td><td class="number">@item.OpeningDebit.ToString("N2")</td><td class="number">@item.OpeningCredit.ToString("N2")</td><td class="number">@item.DebitMovements.ToString("N2")</td><td class="number">@item.CreditMovements.ToString("N2")</td><td class="number">@item.ClosingDebit.ToString("N2")</td><td class="number">@item.ClosingCredit.ToString("N2")</td><td>@(item.HasClosingDifference ? "Diferença" : "OK")</td></tr>}
<tr><td colspan="2"><strong>Totais</strong></td><td class="number"><strong>@Model.TotalOpeningDebit.ToString("N2")</strong></td><td class="number"><strong>@Model.TotalOpeningCredit.ToString("N2")</strong></td><td class="number"><strong>@Model.TotalDebitMovements.ToString("N2")</strong></td><td class="number"><strong>@Model.TotalCreditMovements.ToString("N2")</strong></td><td class="number"><strong>@Model.TotalClosingDebit.ToString("N2")</strong></td><td class="number"><strong>@Model.TotalClosingCredit.ToString("N2")</strong></td><td><strong>@(Model.MovementDifference == 0m ? "Equilibrado" : $"Diferença {Model.MovementDifference:N2}")</strong></td></tr>}
</tbody></table></div>
<p class="form-hint">O saldo final é calculado deterministicamente a partir do saldo inicial e dos movimentos. A coluna Controlo compara esse resultado com o saldo final declarado no plano de contas da mesma fonte SAF-T (PT).</p>
</section>
