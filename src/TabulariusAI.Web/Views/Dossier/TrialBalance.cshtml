@model TabulariusAI.Web.Models.TrialBalanceViewModel
@{ var import = Model.Source.SelectedImport; ViewData["Title"] = $"Balancete · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Contabilidade</p><h1>Balancete</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section><section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="trial-balance-kpis" aria-label="Resumo do balancete"><article><span>Débitos</span><strong>@Model.TotalDebitMovements.ToString("N2")</strong><small>Contas de movimento</small></article><article><span>Créditos</span><strong>@Model.TotalCreditMovements.ToString("N2")</strong><small>Contas de movimento</small></article><article class="@(Model.MovementDifference == 0m ? "is-balanced" : "is-warning")"><span>Diferença</span><strong>@Model.MovementDifference.ToString("N2")</strong><small>@(Model.MovementDifference == 0m ? "Débitos = Créditos" : "Requer verificação")</small></article><article><span>Contas</span><strong>@Model.Rows.Count</strong><small>Apresentadas</small></article></section>
<section class="trial-balance-card"><header class="trial-balance-card-header"><div><p class="section-kicker">Mapa contabilístico</p><h2>Saldos e movimentos</h2></div><form method="get" class="trial-balance-filters"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="trial-balance-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@Model.Search" placeholder="Conta ou descrição" /></div><label class="trial-balance-switch"><input type="checkbox" name="includeZeroAccounts" value="true" checked="@Model.IncludeZeroAccounts"/><span class="switch-track"><span></span></span><span>Contas sem valores</span></label><button class="btn btn-primary" type="submit">Filtrar</button>@if(!string.IsNullOrEmpty(Model.Search) || Model.IncludeZeroAccounts){<a class="btn btn-secondary" asp-action="TrialBalance" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Limpar</a>}</form></header><div class="trial-balance-table-scroll"><table class="trial-balance-table"><thead><tr class="group-row"><th rowspan="2">Conta</th><th rowspan="2">Descrição</th><th colspan="2">Saldo inicial</th><th colspan="2" class="group-movements">Movimentos</th><th colspan="2">Saldo final</th><th rowspan="2" class="center">Controlo</th></tr><tr class="sub-row"><th>Débito</th><th>Crédito</th><th>Débito</th><th>Crédito</th><th>Débito</th><th>Crédito</th></tr></thead><tbody>@if(Model.Rows.Count==0){<tr><td colspan="9" class="trial-balance-empty">Não existem contas para os filtros selecionados.</td></tr>}else{foreach(var item in Model.Rows){<tr class="@(item.IsAggregateAccount ? "aggregate-row" : null)"><td class="account"><strong>@item.AccountId</strong></td><td class="description">@item.Description</td><td class="amount muted">@(item.OpeningDebit == 0m ? "—" : item.OpeningDebit.ToString("N2"))</td><td class="amount muted">@(item.OpeningCredit == 0m ? "—" : item.OpeningCredit.ToString("N2"))</td><td class="amount movement-cell">@(item.DebitMovements == 0m ? "—" : item.DebitMovements.ToString("N2"))</td><td class="amount movement-cell">@(item.CreditMovements == 0m ? "—" : item.CreditMovements.ToString("N2"))</td><td class="amount closing">@(item.ClosingDebit == 0m ? "—" : item.ClosingDebit.ToString("N2"))</td><td class="amount closing">@(item.ClosingCredit == 0m ? "—" : item.ClosingCredit.ToString("N2"))</td><td class="center">@if(item.IsAggregateAccount){<span class="trial-balance-status status-aggregate">Agregadora</span>}else{<span class="trial-balance-status @(item.HasClosingDifference ? "status-difference" : "status-ok")">@(item.HasClosingDifference ? "Diferença" : "OK")</span>}</td></tr>}}</tbody>@if(Model.Rows.Count>0){<tfoot><tr><th colspan="2">Totais (contas de movimento)</th><th class="amount">@Model.TotalOpeningDebit.ToString("N2")</th><th class="amount">@Model.TotalOpeningCredit.ToString("N2")</th><th class="amount movement-cell">@Model.TotalDebitMovements.ToString("N2")</th><th class="amount movement-cell">@Model.TotalCreditMovements.ToString("N2")</th><th class="amount">@Model.TotalClosingDebit.ToString("N2")</th><th class="amount">@Model.TotalClosingCredit.ToString("N2")</th><th></th></tr></tfoot>}</table></div><footer class="trial-balance-footer"><span class="trial-balance-info-icon">i</span><p><strong>Controlo contabilístico.</strong> A comparação do saldo final é efetuada apenas nas contas de movimento. As contas agregadoras são apresentadas para preservar a estrutura do plano, mas não originam falsos alertas nem entram nos totais.</p></footer></section>
<partial name="_AiAnalyticalReport" model='new TabulariusAI.Web.Services.AI.AiAnalyticalReportRequest("trial-balance","Balancete",new { CurrencyCode="EUR",Model.TotalOpeningDebit,Model.TotalOpeningCredit,Model.TotalDebitMovements,Model.TotalCreditMovements,Model.TotalClosingDebit,Model.TotalClosingCredit,Model.MovementDifference,AccountCount=Model.Rows.Count,Accounts=Model.Rows.Where(x=>!x.IsAggregateAccount).OrderByDescending(x=>x.DebitMovements+x.CreditMovements).Take(50) })'/>
