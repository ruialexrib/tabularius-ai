@model TabulariusAI.Web.Models.TrialBalanceViewModel
@{ var import = Model.Source.SelectedImport; ViewData["Title"] = $"Balancete · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">Análise contabilística · SAF-T (PT)</p><h1>Balancete</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear. Saldos iniciais, movimentos e saldos finais por conta.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="trial-balance-summary" aria-label="Resumo do balancete"><article><span>Débitos do período</span><strong>@Model.TotalDebitMovements.ToString("N2")</strong></article><article><span>Créditos do período</span><strong>@Model.TotalCreditMovements.ToString("N2")</strong></article><article class="@(Model.MovementDifference == 0m ? "is-balanced" : "is-warning")"><span>Diferença</span><strong>@Model.MovementDifference.ToString("N2")</strong><small>@(Model.MovementDifference == 0m ? "Balancete equilibrado" : "Verificar movimentos")</small></article></section>
<section class="list-workspace trial-balance-workspace">
<div class="list-toolbar trial-balance-toolbar"><form method="get" class="list-filter-form"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="list-search"><label for="search">Pesquisar conta</label><input id="search" name="search" value="@Model.Search" placeholder="Código ou descrição" /></div><label class="trial-balance-zero-toggle"><input type="checkbox" name="includeZeroAccounts" value="true" checked="@Model.IncludeZeroAccounts" /><span>Incluir contas sem valores</span></label><button class="btn btn-primary">Filtrar</button>@if(!string.IsNullOrEmpty(Model.Search) || Model.IncludeZeroAccounts){<a class="btn btn-secondary" asp-action="TrialBalance" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Limpar</a>}</form><div class="list-count"><strong>@Model.Rows.Count</strong><span>contas</span></div></div>
<div class="table-wrap trial-balance-table-wrap"><table class="trial-balance-table"><thead><tr class="trial-balance-groups"><th rowspan="2" class="account-column">Conta</th><th rowspan="2" class="description-column">Descrição</th><th colspan="2">Saldo inicial</th><th colspan="2" class="movement-group">Movimentos</th><th colspan="2">Saldo final</th><th rowspan="2" class="control-column">Controlo</th></tr><tr><th class="numeric">Débito</th><th class="numeric">Crédito</th><th class="numeric movement-column">Débito</th><th class="numeric movement-column">Crédito</th><th class="numeric">Débito</th><th class="numeric">Crédito</th></tr></thead><tbody>
@if(Model.Rows.Count==0){<tr><td colspan="9" class="empty-row">Não existem contas para os filtros selecionados.</td></tr>}else{foreach(var item in Model.Rows){<tr><td class="account-column"><strong>@item.AccountId</strong></td><td class="description-column">@item.Description</td><td class="numeric amount-muted">@(item.OpeningDebit == 0m ? "—" : item.OpeningDebit.ToString("N2"))</td><td class="numeric amount-muted">@(item.OpeningCredit == 0m ? "—" : item.OpeningCredit.ToString("N2"))</td><td class="numeric movement-column">@(item.DebitMovements == 0m ? "—" : item.DebitMovements.ToString("N2"))</td><td class="numeric movement-column">@(item.CreditMovements == 0m ? "—" : item.CreditMovements.ToString("N2"))</td><td class="numeric closing-amount">@(item.ClosingDebit == 0m ? "—" : item.ClosingDebit.ToString("N2"))</td><td class="numeric closing-amount">@(item.ClosingCredit == 0m ? "—" : item.ClosingCredit.ToString("N2"))</td><td class="control-column"><span class="trial-balance-status @(item.HasClosingDifference ? "status-difference" : "status-ok")">@(item.HasClosingDifference ? "Diferença" : "OK")</span></td></tr>}
</tbody><tfoot><tr><th colspan="2">Totais</th><th class="numeric">@Model.TotalOpeningDebit.ToString("N2")</th><th class="numeric">@Model.TotalOpeningCredit.ToString("N2")</th><th class="numeric movement-column">@Model.TotalDebitMovements.ToString("N2")</th><th class="numeric movement-column">@Model.TotalCreditMovements.ToString("N2")</th><th class="numeric">@Model.TotalClosingDebit.ToString("N2")</th><th class="numeric">@Model.TotalClosingCredit.ToString("N2")</th><th></th></tr></tfoot>}
</table></div>
<div class="trial-balance-note"><strong>Controlo contabilístico</strong><span>O saldo final é calculado a partir do saldo inicial e dos movimentos. O estado compara o resultado com o saldo final declarado na conta da mesma fonte SAF-T (PT).</span></div>
</section>
