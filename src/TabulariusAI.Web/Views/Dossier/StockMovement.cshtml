@model TabulariusAI.Web.Models.SaftStockMovementDetailViewModel
@using System.Globalization
@{var import=Model.Source.SelectedImport;var item=Model.Movement;var pt=CultureInfo.GetCultureInfo("pt-PT");var totalQuantity=item.Lines.Sum(line=>line.Quantity);var estimatedValue=item.Lines.Where(line=>line.UnitPrice.HasValue).Sum(line=>line.Quantity*line.UnitPrice!.Value);ViewData["Title"]=$"{item.DocumentNumber} · Movimentação de mercadorias";}
<partial name="_SaftSourceSelector" model="Model.Source" />
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Movimentação de mercadorias</p><h1>@item.DocumentNumber</h1><p class="lead">@item.MovementType · @item.MovementDate.ToString("dd/MM/yyyy") · estado @(string.IsNullOrWhiteSpace(item.DocumentStatus)?"—":item.DocumentStatus)</p></div><a class="btn btn-secondary" asp-action="StockMovements" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Voltar aos documentos</a></section>
<section class="dashboard-kpis"><article><span class="kpi-icon">LN</span><div><small>Linhas</small><strong>@item.Lines.Count</strong></div></article><article><span class="kpi-icon">QT</span><div><small>Quantidade total</small><strong>@totalQuantity.ToString("N2",pt)</strong></div></article><article><span class="kpi-icon">€</span><div><small>Valor estimado</small><strong>@estimatedValue.ToString("N2",pt) €</strong></div></article></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Informação do documento</p><h2>Detalhes</h2></div></div><dl class="summary-grid"><div><dt>Cliente</dt><dd>@(item.CustomerId??"—")</dd></div><div><dt>Fornecedor</dt><dd>@(item.SupplierId??"—")</dd></div><div><dt>Utilizador</dt><dd>@item.SourceId</dd></div><div><dt>Entrada no sistema</dt><dd>@(item.SystemEntryDate?.ToString("dd/MM/yyyy HH:mm")??"—")</dd></div></dl></section>
<section class="list-workspace"><div class="card-header"><div><p class="section-kicker">Linhas SAF-T</p><h2>Produtos movimentados</h2><p>@item.Lines.Count linhas persistidas a partir do SAF-T (PT).</p></div></div><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Produto</th><th>Descrição</th><th class="number-cell">Quantidade</th><th>Unidade</th><th class="number-cell">Preço unitário</th></tr></thead><tbody>@foreach(var line in item.Lines.OrderBy(line=>line.LineNumber)){<tr><td>@line.LineNumber</td><td><strong>@line.ProductCode</strong></td><td>@line.ProductDescription</td><td class="number-cell">@line.Quantity.ToString("N4",pt)</td><td>@line.UnitOfMeasure</td><td class="number-cell">@(line.UnitPrice?.ToString("N4",pt)??"—")</td></tr>}</tbody></table></div></section>
