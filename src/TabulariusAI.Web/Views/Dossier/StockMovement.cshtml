@model TabulariusAI.Web.Models.SaftStockMovementDetailViewModel
@{var import=Model.Source.SelectedImport;var item=Model.Movement;ViewData["Title"]=$"{item.DocumentNumber} · Movimentação de mercadorias";}
<section class="page-header"><div><p class="eyebrow">Movimentação de mercadorias</p><h1>@item.DocumentNumber</h1><p class="lead">@item.MovementType · @item.MovementDate.ToString("dd/MM/yyyy") · estado @item.DocumentStatus</p></div><a class="btn btn-secondary" asp-action="StockMovements" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Voltar aos documentos</a></section><section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section><section class="panel"><div class="card-header"><div><p class="section-kicker">Documento</p><h2>Dados gerais</h2></div></div><dl class="summary-grid"><div><dt>Cliente</dt><dd>@(item.CustomerId??"—")</dd></div><div><dt>Fornecedor</dt><dd>@(item.SupplierId??"—")</dd></div><div><dt>Utilizador</dt><dd>@item.SourceId</dd></div><div><dt>Entrada no sistema</dt><dd>@(item.SystemEntryDate?.ToString("dd/MM/yyyy HH:mm")??"—")</dd></div></dl></section><section class="panel"><div class="card-header"><div><p class="section-kicker">Linhas</p><h2>Produtos movimentados</h2></div></div><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Produto</th><th>Descrição</th><th class="number-cell">Quantidade</th><th>Unidade</th><th class="number-cell">Preço unitário</th></tr></thead><tbody>@foreach(var line in item.Lines.OrderBy(line=>line.LineNumber)){<tr><td>@line.LineNumber</td><td><strong>@line.ProductCode</strong></td><td>@line.ProductDescription</td><td class="number-cell">@line.Quantity.ToString("N4")</td><td>@line.UnitOfMeasure</td><td class="number-cell">@(line.UnitPrice?.ToString("N4")??"—")</td></tr>}</tbody></table></div></section>
