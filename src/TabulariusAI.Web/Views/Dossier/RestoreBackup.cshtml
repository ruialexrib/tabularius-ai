@model TabulariusAI.Web.Models.DossierRestoreViewModel
@{ ViewData["Title"] = "Restaurar dossier"; }
<section class="page-header"><div><p class="eyebrow">Dossiers contabilísticos</p><h1>Restaurar dossier</h1><p class="lead">Importe um backup JSON criado pelo Tabularius AI. O dossier, as importações SAF-T (PT) e os respetivos dados serão recriados.</p></div><a class="btn btn-secondary" asp-action="Entities">Cancelar</a></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Backup e restauro</p><h2>Selecionar backup</h2><p>O ficheiro é validado antes de qualquer alteração. Não são restaurados utilizadores, credenciais ou definições de AI.</p></div></div><form asp-action="RestoreBackup" method="post" enctype="multipart/form-data" class="form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div><label asp-for="BackupFile"></label><input asp-for="BackupFile" type="file" accept="application/json,.json" /><span asp-validation-for="BackupFile" class="field-error"></span><p class="form-help">Só são aceites backups de dossier JSON compatíveis com esta versão do Tabularius AI.</p></div><div class="form-actions"><button class="btn btn-primary" type="submit">Restaurar dossier</button><a class="btn btn-secondary" asp-action="Entities">Cancelar</a></div></form></section>
