@model TabulariusAI.Web.Models.IncomeStatementViewModel
@{ var import=Model.Source.SelectedImport; ViewData["Title"]=$"Demonstração de Resultados · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">Análise contabilística · SAF-T (PT)</p><h1>Demonstração de Resultados</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="income-kpis"><article><span>Rendimentos</span><strong>@Model.TotalIncome.ToString("N2")</strong></article><article><span>Gastos</span><strong>@Model.TotalExpenses.ToString("N2")</strong></article><article class="@(Model.NetResult >= 0m ? "positive" : "negative")"><span>Resultado</span><strong>@Model.NetResult.ToString("N2")</strong><small>@(Model.NetResult >= 0m ? "Resultado positivo" : "Resultado negativo")</small></article></section>
<section class="income-statement-card"><header><div><p class="section-kicker">Apuramento determinístico</p><h2>Rendimentos e gastos</h2><p>Movimentos líquidos das contas de movimento das classes 6 e 7.</p></div></header><div class="income-columns"><div class="income-section expenses"><div class="income-section-title"><span>Classe 6</span><h3>Gastos</h3><strong>@Model.TotalExpenses.ToString("N2")</strong></div><table><thead><tr><th>Conta</th><th>Descrição</th><th>Valor</th></tr></thead><tbody>@if(Model.Expenses.Count==0){<tr><td colspan="3" class="empty-row">Sem movimentos.</td></tr>}else{foreach(var item in Model.Expenses){<tr><td><strong>@item.AccountId</strong></td><td>@item.Description</td><td class="numeric">@item.Amount.ToString("N2")</td></tr>}}</tbody></table></div><div class="income-section revenues"><div class="income-section-title"><span>Classe 7</span><h3>Rendimentos</h3><strong>@Model.TotalIncome.ToString("N2")</strong></div><table><thead><tr><th>Conta</th><th>Descrição</th><th>Valor</th></tr></thead><tbody>@if(Model.Income.Count==0){<tr><td colspan="3" class="empty-row">Sem movimentos.</td></tr>}else{foreach(var item in Model.Income){<tr><td><strong>@item.AccountId</strong></td><td>@item.Description</td><td class="numeric">@item.Amount.ToString("N2")</td></tr>}}</tbody></table></div></div><footer class="income-result"><span>Resultado do período</span><strong>@Model.NetResult.ToString("N2")</strong></footer></section>
<p class="income-note">Esta análise usa as classes 6 (gastos) e 7 (rendimentos) do plano SNC e considera apenas contas de movimento, evitando dupla contabilização das contas agregadoras.</p>
