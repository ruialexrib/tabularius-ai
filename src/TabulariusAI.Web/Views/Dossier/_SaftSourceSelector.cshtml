@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{
    var import = Model.SelectedImport;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "SaftSummary";
    var selectorAction = action switch { "AccountingEntry" => "AccountingEntries", "SalesInvoice" => "SalesInvoices", "StockMovement" => "StockMovements", "WorkingDocument" => "WorkingDocuments", "Payment" => "Payments", "AccountInvestigation" => "AccountAnalysis", _ => action };
    var isAnalytics = action is "Analytics" or "Anomalies" or "AccountAnalysis" or "AccountInvestigation";
    var isAccountingAnalysis = action is "TrialBalance" or "IncomeStatement" or "BalanceSheet";
}
<div class="saft-source-bar"><div class="saft-source-context"><span class="saft-source-label">Fonte SAF-T (PT)</span><strong>@import.OriginalFileName</strong><small>@(import.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(import.EndDate?.ToString("dd/MM/yyyy") ?? "—") · versão @import.SaftVersion</small></div><form method="get" asp-action="@selectorAction" class="filterbar saft-source-filter"><input type="hidden" name="id" value="@import.DossierId" /><label>Período / ficheiro<select name="importId" onchange="this.form.submit()">@foreach (var source in Model.AvailableImports){<option value="@source.Id" selected="@(source.Id == import.Id)">@(source.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(source.EndDate?.ToString("dd/MM/yyyy") ?? "—") · @source.OriginalFileName</option>}</select></label><noscript><button class="btn btn-secondary" type="submit">Aplicar</button></noscript></form></div>
@if (isAnalytics)
{
<nav class="saft-area-nav" aria-label="Área analítica"><a class="@(action == "Analytics" ? "active" : null)" asp-action="Analytics" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Visão geral</a><a class="@(action == "Anomalies" ? "active" : null)" asp-action="Anomalies" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Anomalias</a><a class="@(action is "AccountAnalysis" or "AccountInvestigation" ? "active" : null)" asp-action="AccountAnalysis" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Análise de contas</a></nav>
}
else if (isAccountingAnalysis)
{
<nav class="saft-area-nav" aria-label="Análise contabilística"><a class="@(action == "TrialBalance" ? "active" : null)" asp-action="TrialBalance" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Balancete</a><a class="@(action == "IncomeStatement" ? "active" : null)" asp-action="IncomeStatement" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Demonstração de Resultados</a><a class="@(action == "BalanceSheet" ? "active" : null)" asp-action="BalanceSheet" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Balanço</a></nav>
}
else
{
<nav class="saft-area-nav" aria-label="Dados SAF-T (PT)"><a class="@(action == "SaftSummary" ? "active" : null)" asp-action="SaftSummary" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Resumo</a><a class="@(action == "Accounts" ? "active" : null)" asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Contas</a><a class="@(action == "Customers" ? "active" : null)" asp-action="Customers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Clientes</a><a class="@(action == "Suppliers" ? "active" : null)" asp-action="Suppliers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Fornecedores</a><a class="@(action == "Products" ? "active" : null)" asp-action="Products" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Produtos</a><a class="@(action == "TaxTable" ? "active" : null)" asp-action="TaxTable" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Impostos</a><a class="@(action is "AccountingEntries" or "AccountingEntry" ? "active" : null)" asp-action="AccountingEntries" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Lançamentos</a><a class="@(action is "SalesInvoices" or "SalesInvoice" ? "active" : null)" asp-action="SalesInvoices" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Documentos de vendas</a><a class="@(action is "WorkingDocuments" or "WorkingDocument" ? "active" : null)" asp-action="WorkingDocuments" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Documentos de conferência</a><a class="@(action is "StockMovements" or "StockMovement" ? "active" : null)" asp-action="StockMovements" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Movimentação de mercadorias</a><a class="@(action is "Payments" or "Payment" ? "active" : null)" asp-action="Payments" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Recibos</a></nav>
}
