@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{ var import = Model.SelectedImport; var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "SaftSummary"; }
<div class="saft-source-bar"><div class="saft-source-context"><span class="saft-source-label">Fonte SAF-T (PT)</span><strong>@import.OriginalFileName</strong><small>@(import.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(import.EndDate?.ToString("dd/MM/yyyy") ?? "—") · versão @import.SaftVersion</small></div><form method="get" asp-action="@(action == "AccountingEntry" ? "AccountingEntries" : action)" class="filterbar saft-source-filter"><input type="hidden" name="id" value="@import.DossierId" /><label>Período / ficheiro<select name="importId" onchange="this.form.submit()">@foreach (var source in Model.AvailableImports){<option value="@source.Id" selected="@(source.Id == import.Id)">@(source.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(source.EndDate?.ToString("dd/MM/yyyy") ?? "—") · @source.OriginalFileName</option>}</select></label><noscript><button class="btn btn-secondary" type="submit">Aplicar</button></noscript></form></div>
<nav class="saft-area-nav" aria-label="Áreas da fonte SAF-T (PT)"><a class="@(action == "SaftSummary" ? "active" : null)" asp-action="SaftSummary" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Resumo</a><a class="@(action == "Accounts" ? "active" : null)" asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Contas</a><a class="@(action == "Customers" ? "active" : null)" asp-action="Customers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Clientes</a><a class="@(action == "Suppliers" ? "active" : null)" asp-action="Suppliers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Fornecedores</a><a class="@(action == "Products" ? "active" : null)" asp-action="Products" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Produtos</a><a class="@(action is "AccountingEntries" or "AccountingEntry" ? "active" : null)" asp-action="AccountingEntries" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Lançamentos</a><span class="saft-nav-separator" aria-hidden="true"></span><a class="@(action == "TrialBalance" ? "active" : null)" asp-action="TrialBalance" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Balancete</a><a class="@(action == "IncomeStatement" ? "active" : null)" asp-action="IncomeStatement" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Demonstração de Resultados</a><a class="@(action == "BalanceSheet" ? "active" : null)" asp-action="BalanceSheet" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Balanço</a></nav>
