@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{
    var import = Model.SelectedImport;
    ViewData["Title"] = $"Contas · {import.Dossier.AccountingEntity.Name} · {import.Dossier.FiscalYear}";
}
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Contas</p><h1>Plano de contas</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel source-panel">
    <div class="card-header"><div><p class="section-kicker">Fonte SAF-T (PT)</p><h2>@import.OriginalFileName</h2><p>Período: @(import.StartDate?.ToString("dd/MM/yyyy") ?? "—") a @(import.EndDate?.ToString("dd/MM/yyyy") ?? "—")</p></div></div>
    <form method="get" asp-action="Accounts" class="source-selector"><input type="hidden" name="id" value="@import.DossierId" /><label for="importId">Importação apresentada</label><select id="importId" name="importId" onchange="this.form.submit()">@foreach (var source in Model.AvailableImports) { <option value="@source.Id" selected="@(source.Id == import.Id)">@source.OriginalFileName · @(source.StartDate?.ToString("dd/MM/yyyy") ?? "—") — @(source.EndDate?.ToString("dd/MM/yyyy") ?? "—")</option> }</select><noscript><button class="btn btn-primary" type="submit">Aplicar</button></noscript></form>
    <nav class="workspace-links"><a asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Contas</a><a asp-action="Customers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Clientes</a><a asp-action="Suppliers" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Fornecedores</a></nav>
</section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">@import.Accounts.Count registos</p><h2>Plano de contas</h2></div></div>@if (import.Accounts.Count == 0) { <p>Esta importação não contém contas persistidas. Volte a importar o SAF-T (PT) para carregar os dados desta área.</p> } else { <div class="table-wrap"><table><thead><tr><th>Conta</th><th>Descrição</th><th>Débito inicial</th><th>Crédito inicial</th><th>Débito final</th><th>Crédito final</th><th>Taxonomia</th></tr></thead><tbody>@foreach (var item in import.Accounts.OrderBy(item => item.AccountId)) { <tr><td><strong>@item.AccountId</strong></td><td>@item.Description</td><td>@item.OpeningDebitBalance.ToString("N2")</td><td>@item.OpeningCreditBalance.ToString("N2")</td><td>@item.ClosingDebitBalance.ToString("N2")</td><td>@item.ClosingCreditBalance.ToString("N2")</td><td>@(item.TaxonomyReference ?? "—")</td></tr> }</tbody></table></div> }</section>
