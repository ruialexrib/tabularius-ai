@model TabulariusAI.Web.Models.SaftImportSelectionViewModel
@{ var import = Model.SelectedImport; ViewData["Title"] = $"Contas · {import.Dossier.AccountingEntity.Name} · {import.Dossier.FiscalYear}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Contas</p><h1>Plano de contas</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model" /></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">@import.Accounts.Count registos</p><h2>Plano de contas</h2></div></div>@if (import.Accounts.Count == 0) { <p class="empty-row">Esta importação não contém contas persistidas. Volte a importar o SAF-T (PT) para carregar os dados desta área.</p> } else { <div class="table-wrap"><table><thead><tr><th>Conta</th><th>Descrição</th><th>Débito inicial</th><th>Crédito inicial</th><th>Débito final</th><th>Crédito final</th><th>Taxonomia</th></tr></thead><tbody>@foreach (var item in import.Accounts.OrderBy(item => item.AccountId)) { <tr><td><strong>@item.AccountId</strong></td><td>@item.Description</td><td>@item.OpeningDebitBalance.ToString("N2")</td><td>@item.OpeningCreditBalance.ToString("N2")</td><td>@item.ClosingDebitBalance.ToString("N2")</td><td>@item.ClosingCreditBalance.ToString("N2")</td><td>@(item.TaxonomyReference ?? "—")</td></tr> }</tbody></table></div> }</section>
