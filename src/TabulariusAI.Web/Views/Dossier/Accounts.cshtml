@model TabulariusAI.Web.Models.SaftListViewModel<TabulariusAI.Web.Data.Entities.SaftAccount>
@{ var import = Model.Source.SelectedImport; var list = Model.List; ViewData["Title"] = $"Contas · {import.Dossier.AccountingEntity.Name} · {import.Dossier.FiscalYear}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Contabilidade</p><h1>Plano de contas</h1><p class="lead">@import.Dossier.AccountingEntity.Name · exercício @import.Dossier.FiscalYear.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@import.DossierId">Voltar ao dossier</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="list-workspace"><div class="list-toolbar"><form method="get" class="list-filter-form"><input type="hidden" name="id" value="@import.DossierId"/><input type="hidden" name="importId" value="@import.Id"/><div class="list-search"><label for="search">Pesquisar</label><input id="search" name="search" value="@list.Search" placeholder="Conta, descrição ou taxonomia" /></div><div class="list-page-size"><label for="pageSize">Registos</label><select id="pageSize" name="pageSize"><option selected="@(list.PageSize==10)" value="10">10</option><option selected="@(list.PageSize==25)" value="25">25</option><option selected="@(list.PageSize==50)" value="50">50</option><option selected="@(list.PageSize==100)" value="100">100</option></select></div><button class="btn btn-primary" type="submit">Filtrar</button>@if(!string.IsNullOrEmpty(list.Search)){<a class="btn btn-secondary" asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-pageSize="@list.PageSize">Limpar</a>}</form><div class="list-count"><strong>@list.TotalItems</strong><span>registos encontrados</span></div></div>
<div class="table-wrap"><table><thead><tr><th>Conta</th><th>Descrição</th><th>Débito inicial</th><th>Crédito inicial</th><th>Débito final</th><th>Crédito final</th><th>Taxonomia</th></tr></thead><tbody>@if(list.Items.Count==0){<tr><td colspan="7" class="empty-row">Não foram encontrados registos para os filtros selecionados.</td></tr>}else{foreach(var item in list.Items){<tr><td><strong>@item.AccountId</strong></td><td>@item.Description</td><td>@item.OpeningDebitBalance.ToString("N2")</td><td>@item.OpeningCreditBalance.ToString("N2")</td><td>@item.ClosingDebitBalance.ToString("N2")</td><td>@item.ClosingCreditBalance.ToString("N2")</td><td>@(item.TaxonomyReference ?? "—")</td></tr>}}</tbody></table></div>
<div class="list-footer"><span>A mostrar @list.FirstItem–@list.LastItem de @list.TotalItems</span><nav class="pagination" aria-label="Paginação"><a class="page-link @(list.HasPreviousPage?"":"disabled")" asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page-1)">Anterior</a><span class="page-current">Página @list.Page de @list.TotalPages</span><a class="page-link @(list.HasNextPage?"":"disabled")" asp-action="Accounts" asp-route-id="@import.DossierId" asp-route-importId="@import.Id" asp-route-search="@list.Search" asp-route-pageSize="@list.PageSize" asp-route-page="@(list.Page+1)">Seguinte</a></nav></div></section>
