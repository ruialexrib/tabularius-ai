@model TabulariusAI.Web.Models.AnomaliesViewModel
@{ViewData["Title"]="Anomalias";var s=Model.Source;}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica</p><h1>Anomalias</h1><p class="lead">Controlos determinísticos sobre os lançamentos da fonte SAF-T (PT), com evidência rastreável.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@s.SelectedImport.DossierId">Voltar ao dossier</a></section><partial name="_SaftSourceSelector" model="s"/>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Controlo contabilístico</p><h2>@Model.Findings.Count situação(ões) identificada(s)</h2><p>As regras atuais verificam desequilíbrios, montantes negativos, natureza débito/crédito inválida e identificadores de lançamento duplicados.</p></div></div>@if(Model.Findings.Count==0){<div class="analytics-empty"><strong>Sem anomalias nas regras atuais</strong><span>Este resultado não substitui procedimentos de revisão contabilística adicionais.</span></div>}else{<div class="table-wrap"><table><thead><tr><th>Severidade</th><th>Regra</th><th>Referência</th><th>Descrição</th><th>Diferença</th><th>Ação</th></tr></thead><tbody>@foreach(var f in Model.Findings){<tr><td><span class="analytics-severity @f.Severity.ToLowerInvariant().Replace("é","e")">@f.Severity</span></td><td><strong>@f.Type</strong></td><td>@f.Reference</td><td>@f.Description</td><td class="number-cell">@(f.Difference?.ToString("N2")??"—")</td><td>@if(f.TransactionId.HasValue){<a class="table-action" asp-action="AccountingEntry" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id" asp-route-transactionId="@f.TransactionId">Ver lançamento</a>}</td></tr>}</tbody></table></div>}</section>
