@model TabulariusAI.Web.Models.AnomaliesViewModel
@{ViewData["Title"]="Anomalias";var s=Model.Source;var high=Model.Findings.Count(x=>x.Severity=="Alta");var medium=Model.Findings.Count(x=>x.Severity=="Média");var rules=Model.Findings.Select(x=>x.RuleId).Distinct().Count();}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica</p><h1>Anomalias</h1><p class="lead">Motor de controlos determinísticos sobre a fonte SAF-T (PT), com regras identificadas e evidência rastreável.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@s.SelectedImport.DossierId">Voltar ao dossier</a></section><partial name="_SaftSourceSelector" model="s"/>
<section class="analytics-kpis"><article><span>Situações</span><strong>@Model.Findings.Count</strong><small>resultados dos controlos</small></article><article><span>Severidade alta</span><strong>@high</strong><small>prioridade de revisão</small></article><article><span>Severidade média</span><strong>@medium</strong><small>situações a validar</small></article><article><span>Regras acionadas</span><strong>@rules</strong><small>de 7 regras ativas</small></article></section>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Controlo contabilístico</p><h2>@Model.Findings.Count situação(ões) identificada(s)</h2><p>Regras ativas: ACC-001 equilíbrio do lançamento, ACC-002 montantes negativos, ACC-003 natureza débito/crédito, ACC-004 identificadores duplicados, ACC-005 datas fora do período SAF-T (PT), ACC-006 contas inexistentes no plano e ACC-007 montantes invulgares face ao histórico da própria conta.</p></div></div>@if(Model.Findings.Count==0){<div class="analytics-empty"><strong>Sem anomalias nas regras atuais</strong><span>Este resultado não substitui procedimentos de revisão contabilística adicionais.</span></div>}else{<div class="table-wrap"><table><thead><tr><th>ID</th><th>Severidade</th><th>Regra</th><th>Referência</th><th>Descrição / evidência</th><th>Diferença</th><th>Ação</th></tr></thead><tbody>@foreach(var f in Model.Findings){<tr><td><strong>@f.RuleId</strong></td><td><span class="analytics-severity @f.Severity.ToLowerInvariant().Replace("é","e")">@f.Severity</span></td><td><strong>@f.Type</strong></td><td>@f.Reference</td><td>@f.Description</td><td class="number-cell">@(f.Difference?.ToString("N2")??"—")</td><td>@if(f.TransactionId.HasValue){<a class="table-action" asp-action="AccountingEntry" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id" asp-route-transactionId="@f.TransactionId">Ver evidência</a>}</td></tr>}</tbody></table></div>}</section>
<partial name="_AiAnalyticalReport" model='new TabulariusAI.Web.Services.AI.AiAnalyticalReportRequest("anomalies","Anomalias",new { CurrencyCode="EUR",Total=Model.Findings.Count,HighSeverity=high,MediumSeverity=medium,Findings=Model.Findings.Take(50) })'/>
