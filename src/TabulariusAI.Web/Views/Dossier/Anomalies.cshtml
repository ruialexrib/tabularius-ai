@model TabulariusAI.Web.Models.AnomaliesViewModel
@{ViewData["Title"]="Anomalias";var s=Model.Source;var high=Model.Findings.Count(x=>x.Severity=="Alta");var medium=Model.Findings.Count(x=>x.Severity=="Média");var passed=Model.Checks.Count(x=>x.Passed);var failed=Model.Checks.Count-passed;}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica</p><h1>Anomalias</h1><p class="lead">Motor de controlos determinísticos sobre a fonte SAF-T (PT), com regras identificadas e evidência rastreável.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@s.SelectedImport.DossierId">Voltar ao dossier</a></section><partial name="_SaftSourceSelector" model="s"/>
<section class="analytics-kpis"><article><span>Controlos executados</span><strong>@Model.Checks.Count</strong><small>regras determinísticas</small></article><article><span>Passaram</span><strong>@passed</strong><small>sem situações detetadas</small></article><article class="@(failed>0?"analytics-kpi-alert":"")"><span>Não passaram</span><strong>@failed</strong><small>controlos com ocorrências</small></article><article><span>Situações</span><strong>@Model.Findings.Count</strong><small>@high alta · @medium média</small></article></section>
<section class="panel anomaly-check-panel"><div class="card-header"><div><p class="section-kicker">Controlos executados</p><h2>Resultado por regra</h2><p>Todos os controlos disponíveis são apresentados, mesmo quando não identificam anomalias.</p></div></div><div class="anomaly-check-grid">@foreach(var check in Model.Checks){<article class="anomaly-check-card @(check.Passed?"passed":"failed")"><div class="anomaly-check-heading"><span class="anomaly-check-id">@check.RuleId</span><span class="anomaly-check-status">@(check.Passed?"✓ Passou":"! Não passou")</span></div><strong>@check.Name</strong><p>@check.Description</p><div class="anomaly-check-meta"><span>Severidade <b>@check.Severity</b></span><span>Ocorrências <b>@check.FindingCount</b></span></div></article>}</div></section>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Evidência</p><h2>@Model.Findings.Count situação(ões) identificada(s)</h2><p>As situações abaixo correspondem apenas aos controlos que não passaram e permitem rastrear a evidência contabilística.</p></div></div>@if(Model.Findings.Count==0){<div class="analytics-empty"><strong>Todos os controlos passaram</strong><span>Não foram identificadas anomalias pelas regras atualmente disponíveis. Este resultado não substitui procedimentos de revisão contabilística adicionais.</span></div>}else{<div class="table-wrap"><table><thead><tr><th>ID</th><th>Severidade</th><th>Regra</th><th>Referência</th><th>Descrição / evidência</th><th>Diferença</th><th>Ação</th></tr></thead><tbody>@foreach(var f in Model.Findings){<tr><td><strong>@f.RuleId</strong></td><td><span class="analytics-severity @f.Severity.ToLowerInvariant().Replace("é","e")">@f.Severity</span></td><td><strong>@f.Type</strong></td><td>@f.Reference</td><td>@f.Description</td><td class="number-cell">@(f.Difference?.ToString("N2")??"—")</td><td>@if(f.TransactionId.HasValue){<a class="table-action" asp-action="AccountingEntry" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id" asp-route-transactionId="@f.TransactionId">Ver evidência</a>}</td></tr>}</tbody></table></div>}</section>
<partial name="_AiAnalyticalReport" model='new TabulariusAI.Web.Services.AI.AiAnalyticalReportRequest("anomalies","Anomalias",new { CurrencyCode="EUR",Total=Model.Findings.Count,HighSeverity=high,MediumSeverity=medium,Checks=Model.Checks,Findings=Model.Findings.Take(50) })'/>
