@model TabulariusAI.Web.Models.SaftEntryDetailViewModel
@{ var import=Model.Source.SelectedImport; var item=Model.Transaction; ViewData["Title"]=$"Lançamento {item.TransactionId} · {import.Dossier.AccountingEntity.Name}"; }
<section class="page-header"><div><p class="eyebrow">SAF-T (PT) · Lançamento contabilístico</p><h1>@item.TransactionId</h1><p class="lead">@item.Description · @item.TransactionDate.ToString("dd/MM/yyyy") · diário @item.JournalId.</p></div><a class="btn btn-secondary" asp-action="AccountingEntries" asp-route-id="@import.DossierId" asp-route-importId="@import.Id">Voltar aos lançamentos</a></section>
<section class="panel saft-source-panel"><partial name="_SaftSourceSelector" model="Model.Source" /></section>
<section class="panel"><div class="card-header"><div><p class="section-kicker">Identificação</p><h2>Dados do lançamento</h2></div></div><div class="summary-grid"><div><span>Diário</span><strong>@item.JournalId · @item.JournalDescription</strong></div><div><span>Período</span><strong>@item.Period</strong></div><div><span>Data</span><strong>@item.TransactionDate.ToString("dd/MM/yyyy")</strong></div><div><span>Data contabilística</span><strong>@item.GlPostingDate.ToString("dd/MM/yyyy")</strong></div><div><span>Documento</span><strong>@(item.DocArchivalNumber ?? "—")</strong></div><div><span>Tipo</span><strong>@item.TransactionType</strong></div></div></section>
<section class="list-workspace"><div class="card-header"><div><p class="section-kicker">Débitos e créditos</p><h2>Linhas contabilísticas</h2><p>Cada linha representa um movimento numa conta do lançamento selecionado.</p></div><div class="list-count"><strong>@item.Lines.Count</strong><span>linhas</span></div></div><div class="table-wrap"><table><thead><tr><th>Registo</th><th>Conta</th><th>Descrição</th><th>Documento origem</th><th class="numeric">Débito</th><th class="numeric">Crédito</th></tr></thead><tbody>@foreach(var line in item.Lines.OrderBy(line => line.Id)){<tr><td>@line.RecordId</td><td><strong>@line.AccountId</strong></td><td>@line.Description</td><td>@(line.SourceDocumentId ?? "—")</td><td class="numeric">@(line.Side == "D" ? line.Amount.ToString("N2") : "—")</td><td class="numeric">@(line.Side == "C" ? line.Amount.ToString("N2") : "—")</td></tr>}</tbody><tfoot><tr><th colspan="4">Totais</th><th class="numeric">@Model.TotalDebit.ToString("N2")</th><th class="numeric">@Model.TotalCredit.ToString("N2")</th></tr></tfoot></table></div></section>
