@using System.Globalization
@model TabulariusAI.Web.Models.AccountInvestigationViewModel
@{ViewData["Title"]=$"Conta {Model.AccountId}";var s=Model.Source;var max=Math.Max(1m,Model.Monthly.Select(x=>Math.Max(x.Debit,x.Credit)).DefaultIfEmpty(1m).Max());}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica · Análise de contas</p><h1>@Model.AccountId · @Model.Description</h1><p class="lead">Investigação determinística da conta, com evolução mensal, movimentos e principais contrapartidas.</p></div><a class="btn btn-secondary" asp-action="AccountAnalysis" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Voltar à análise de contas</a></section>
<partial name="_SaftSourceSelector" model="s"/>
<section class="analytics-kpis"><article><span>Saldo inicial</span><strong>@((Model.OpeningDebit-Model.OpeningCredit).ToString("N2")) €</strong><small>Débito menos crédito reportado</small></article><article><span>Movimento do período</span><strong>@((Model.Debit-Model.Credit).ToString("N2")) €</strong><small>@Model.Debit.ToString("N2") € D · @Model.Credit.ToString("N2") € C</small></article><article><span>Saldo final</span><strong>@((Model.ClosingDebit-Model.ClosingCredit).ToString("N2")) €</strong><small>Débito menos crédito reportado</small></article><article><span>Movimentos</span><strong>@Model.Movements.Count</strong><small>@Model.Movements.Select(x=>x.TransactionLocalId).Distinct().Count() lançamentos</small></article></section>
<section class="panel analytics-chart-panel"><div class="card-header"><div><p class="section-kicker">Evolução mensal</p><h2>Débitos e créditos</h2><p>Movimentos agrupados pelo mês da data do lançamento contabilístico.</p></div></div><div class="analytics-bars">@foreach(var m in Model.Monthly){var d=(double)(m.Debit/max*100);var c=(double)(m.Credit/max*100);<div class="analytics-month"><span>@CultureInfo.GetCultureInfo("pt-PT").DateTimeFormat.GetAbbreviatedMonthName(m.Month)</span><div class="analytics-bar-pair"><i class="analytics-bar debit" style="height:@d.ToString("0.##",CultureInfo.InvariantCulture)%" title="Débito @m.Debit.ToString("N2") €"></i><i class="analytics-bar credit" style="height:@c.ToString("0.##",CultureInfo.InvariantCulture)%" title="Crédito @m.Credit.ToString("N2") €"></i></div><small>@m.Debit.ToString("N0") / @m.Credit.ToString("N0")</small></div>}</div><div class="analytics-legend"><span><i class="debit"></i> Débito</span><span><i class="credit"></i> Crédito</span></div></section>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Contrapartidas</p><h2>Contas relacionadas</h2><p>Contas presentes nos mesmos lançamentos da conta investigada. O volume representa os movimentos dessas contas nesses lançamentos.</p></div></div>@if(Model.Counterparts.Count==0){<p class="empty-row">Não foram identificadas contrapartidas.</p>}else{<div class="table-wrap"><table><thead><tr><th>Conta</th><th>Descrição</th><th>Lançamentos comuns</th><th>Volume</th></tr></thead><tbody>@foreach(var row in Model.Counterparts){<tr><td><strong>@row.AccountId</strong></td><td>@row.Description</td><td>@row.TransactionCount</td><td class="number-cell">@row.MovementVolume.ToString("N2") €</td></tr>}</tbody></table></div>}</section>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Rastreabilidade</p><h2>Movimentos da conta</h2><p>Cada linha permite regressar ao lançamento contabilístico que lhe deu origem.</p></div><div class="list-count"><strong>@Model.Movements.Count</strong><span>linhas</span></div></div><div class="table-wrap"><table><thead><tr><th>Data</th><th>Lançamento</th><th>Diário</th><th>Descrição</th><th>Documento</th><th>Natureza</th><th>Montante</th></tr></thead><tbody>@foreach(var row in Model.Movements){<tr><td>@row.Date.ToString("dd/MM/yyyy")</td><td><a asp-action="AccountingEntry" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id" asp-route-transactionId="@row.TransactionLocalId"><strong>@row.TransactionId</strong></a></td><td>@row.JournalId</td><td>@row.Description</td><td>@(row.SourceDocumentId??"—")</td><td>@(row.Side=="D"?"Débito":"Crédito")</td><td class="number-cell">@row.Amount.ToString("N2") €</td></tr>}</tbody></table></div></section>
<partial name="_AiAnalyticalReport" model='new TabulariusAI.Web.Services.AI.AiAnalyticalReportRequest("account-analysis","Investigação da conta",new { CurrencyCode="EUR",Model.AccountId,Model.Description,OpeningBalance=Model.OpeningDebit-Model.OpeningCredit,PeriodMovement=Model.Debit-Model.Credit,ClosingBalance=Model.ClosingDebit-Model.ClosingCredit,Model.Monthly,TopMovements=Model.Movements.OrderByDescending(x=>x.Amount).Take(20),Model.Counterparts })'/>
