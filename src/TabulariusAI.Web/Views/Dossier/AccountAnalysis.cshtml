@model TabulariusAI.Web.Models.AccountAnalysisViewModel
@{ViewData["Title"]="Análise de contas";var s=Model.Source;}
<section class="page-header analytics-header"><div><p class="eyebrow">Área analítica</p><h1>Análise de contas</h1><p class="lead">Movimentos, concentração e saldo líquido por conta contabilística.</p></div><a class="btn btn-secondary" asp-action="Details" asp-route-id="@s.SelectedImport.DossierId">Voltar ao dossier</a></section><partial name="_SaftSourceSelector" model="s"/>
<section class="panel list-workspace"><div class="card-header"><div><p class="section-kicker">Movimentos contabilísticos</p><h2>@Model.Rows.Count conta(s) com movimento</h2><p>Valores calculados exclusivamente a partir das linhas de lançamentos da fonte selecionada.</p></div></div><form method="get" class="list-toolbar"><input type="hidden" name="id" value="@s.SelectedImport.DossierId"/><input type="hidden" name="importId" value="@s.SelectedImport.Id"/><input name="search" value="@Model.Search" placeholder="Pesquisar conta ou descrição..."/><button class="btn btn-primary" type="submit">Pesquisar</button>@if(!string.IsNullOrWhiteSpace(Model.Search)){<a class="btn btn-secondary" asp-action="AccountAnalysis" asp-route-id="@s.SelectedImport.DossierId" asp-route-importId="@s.SelectedImport.Id">Limpar</a>}</form><div class="table-wrap"><table><thead><tr><th>Conta</th><th>Descrição</th><th>Linhas</th><th>Débito</th><th>Crédito</th><th>Movimento líquido</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><strong>@row.AccountId</strong></td><td>@row.Description</td><td>@row.LineCount</td><td class="number-cell">@row.Debit.ToString("N2") €</td><td class="number-cell">@row.Credit.ToString("N2") €</td><td class="number-cell"><strong>@row.NetMovement.ToString("N2") €</strong></td></tr>}</tbody></table></div></section>
<partial name="_AiAnalyticalReport" model='new TabulariusAI.Web.Services.AI.AiAnalyticalReportRequest("account-analysis","Análise de contas",new { CurrencyCode="EUR",Search=Model.Search,AccountCount=Model.Rows.Count,Accounts=Model.Rows.OrderByDescending(x=>x.Debit+x.Credit).Take(50) })'/>
