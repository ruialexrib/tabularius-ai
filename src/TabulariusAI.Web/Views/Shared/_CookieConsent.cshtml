@model TabulariusAI.Web.Data.Identity.ApplicationUser
<aside class="cookie-consent" role="dialog" aria-live="polite" aria-label="Consentimento de cookies">
    <div>
        <strong>Cookies no Tabularius AI</strong>
        <p>Utilizamos cookies essenciais para manter a sessão segura e guardar as suas preferências. Ao continuar, concorda com a utilização destes cookies.</p>
    </div>
    <form asp-controller="Account" asp-action="AcceptCookieConsent" method="post">
        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        <button type="submit" class="btn btn-primary">Aceitar</button>
    </form>
</aside>
