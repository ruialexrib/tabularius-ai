@using TabulariusAI.Web.Models
@using TabulariusAI.Web.Data.Identity
@using Microsoft.AspNetCore.Identity
@using System.Runtime.InteropServices
@inject ApplicationInfo AppInfo
@inject IWebHostEnvironment HostEnvironment
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userName = currentUser?.DisplayName ?? currentUser?.UserName ?? User.Identity?.Name ?? "Utilizador";
    var userInitial = userName.Trim().FirstOrDefault().ToString().ToUpperInvariant();
    var userIdentifier = currentUser?.Email ?? currentUser?.UserName ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tabularius AI</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/version.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/import.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lists.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operation-progress.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contextbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fixed-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-titles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accounting-entry.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <header class="app-header">
            <div class="brand-area"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">T</span><span>Tabularius AI</span><small class="version-badge">v@(AppInfo.Version)</small></a><span class="brand-description">@AppInfo.Description</span></div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="topbar-actions"><details class="user-menu"><summary><span class="user-avatar" aria-hidden="true">@userInitial</span><span class="user-identity"><strong>@userName</strong></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></summary><div class="user-dropdown"><div class="user-dropdown-heading"><span class="user-avatar" aria-hidden="true">@userInitial</span><div><strong>@userName</strong><small>@userIdentifier</small></div></div>@if (User.IsInRole(ApplicationRoles.Administrator)){<a class="user-dropdown-action" asp-controller="Users" asp-action="Index"><span aria-hidden="true">◎</span> Gerir utilizadores</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="user-dropdown-action"><span aria-hidden="true">↪</span> Terminar sessão</button></form></div></details></div>
            }
        </header>
        <aside class="sidebar" aria-label="Navegação principal"><nav><p class="nav-heading">Aplicação</p><a class="nav-item" asp-controller="Home" asp-action="Index">Início</a><p class="nav-heading">Dossiers contabilísticos</p><a class="nav-item" asp-controller="Dossier" asp-action="Entities">Entidades e exercícios</a><a class="nav-item" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a>@if(User.IsInRole(ApplicationRoles.Administrator)){<p class="nav-heading">Administração</p><a class="nav-item" asp-controller="Users" asp-action="Index">Utilizadores</a>}<div class="nav-context-note"><strong>Área de trabalho</strong><span>Selecione uma entidade e um exercício para aceder aos dados SAF-T (PT), análises e restantes operações do dossier.</span></div></nav></aside>
        <main class="app-content">@RenderBody()</main>
        <footer class="contextbar"><span class="context-item context-copyright context-with-tooltip" tabindex="0"><span class="context-copyright-icon" aria-hidden="true">©</span> @DateTime.Today.Year Tabularius AI · Rui Ribeiro · Licença MIT<span class="context-tooltip context-tooltip-left" role="tooltip"><strong>Sobre o projeto</strong><span><small>Aplicação</small><b>Tabularius AI</b></span><span><small>Autor</small><b>Rui Ribeiro</b></span><span><small>Licença</small><b>MIT · Open source</b></span><span><small>Repositório</small><b>ruialexrib/tabularius-ai</b></span></span></span><span class="context-spacer" aria-hidden="true"></span><span class="context-item context-with-tooltip" tabindex="0"><span class="context-status-dot" aria-hidden="true"></span> Base de dados: Online<span class="context-tooltip" role="tooltip"><strong>Base de dados</strong><span><small>Estado</small><b class="tooltip-online">● Online</b></span><span><small>Persistência</small><b>Dados da aplicação</b></span></span></span><span class="context-item context-with-tooltip" tabindex="0"><span class="context-icon" aria-hidden="true">v</span> v@(AppInfo.Version)<span class="context-tooltip context-tooltip-right" role="tooltip"><strong>Versão da aplicação</strong><span><small>Tabularius AI</small><b>v@(AppInfo.Version)</b></span><span><small>Ambiente</small><b>@HostEnvironment.EnvironmentName</b></span><span><small>Runtime</small><b>@RuntimeInformation.FrameworkDescription</b></span><span><small>Execução</small><b>@(Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER") == "true" ? "Docker" : "Host local")</b></span></span></span></footer>
    </div>
    <div class="operation-progress" data-operation-progress aria-hidden="true" aria-live="polite" aria-label="Operação em curso"><div class="operation-progress-card" role="status"><span class="operation-spinner" aria-hidden="true"></span><div class="operation-progress-copy"><small>Tabularius AI</small><strong>A processar o pedido</strong><p>Aguarde enquanto preparamos a informação.</p></div></div></div>
    <script src="~/js/operation-progress.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
