@using TabulariusAI.Web.Models
@inject ApplicationInfo AppInfo
<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tabularius AI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/version.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/import.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lists.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operation-progress.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="app-header">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">T</span><span>Tabularius AI</span><small class="version-badge">v@(AppInfo.Version)</small></a>
            <span class="brand-description">@AppInfo.Description</span>
        </header>
        <aside class="sidebar" aria-label="Navegação principal"><nav><p class="nav-heading">Aplicação</p><a class="nav-item" asp-controller="Home" asp-action="Index">Início</a><p class="nav-heading">Dossiers contabilísticos</p><a class="nav-item" asp-controller="Dossier" asp-action="Entities">Entidades e exercícios</a><a class="nav-item" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a><div class="nav-context-note"><strong>Área de trabalho</strong><span>Selecione uma entidade e um exercício para aceder aos dados SAF-T (PT), análises e restantes operações do dossier.</span></div></nav></aside>
        <main class="app-content">@RenderBody()</main>
        <footer class="contextbar"><span>Tabularius AI</span><span>SAF-T (PT)</span><span class="footer-version-badge">v@(AppInfo.Version)</span></footer>
    </div>
    <div class="operation-progress" data-operation-progress aria-hidden="true" aria-live="polite" aria-label="Operação em curso">
        <div class="operation-progress-card" role="status">
            <span class="operation-spinner" aria-hidden="true"></span>
            <div class="operation-progress-copy"><small>Tabularius AI</small><strong>A processar o pedido</strong><p>Aguarde enquanto preparamos a informação.</p></div>
        </div>
    </div>
    <script src="~/js/operation-progress.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
