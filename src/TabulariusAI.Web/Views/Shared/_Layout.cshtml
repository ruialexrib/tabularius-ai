@using TabulariusAI.Web.Models
@using TabulariusAI.Web.Data.Identity
@using TabulariusAI.Web.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Runtime.InteropServices
@using Microsoft.Data.Sqlite
@inject ApplicationInfo AppInfo
@inject IWebHostEnvironment HostEnvironment
@inject UserManager<ApplicationUser> UserManager
@inject TabulariusDbContext DbContext
@{var currentUser=await UserManager.GetUserAsync(User);var userName=currentUser?.DisplayName??currentUser?.UserName??User.Identity?.Name??"Utilizador";var userInitial=userName.Trim().FirstOrDefault().ToString().ToUpperInvariant();var userIdentifier=currentUser?.Email??currentUser?.UserName??User.Identity?.Name;var aiSettings=User.Identity?.IsAuthenticated==true?await DbContext.AiSettings.AsNoTracking().SingleOrDefaultAsync():null;var aiEnabled=aiSettings?.IsEnabled==true;var isSqlite=DbContext.Database.IsSqlite();string? sqliteLocation=null;if(isSqlite){var dataSource=new SqliteConnectionStringBuilder(DbContext.Database.GetConnectionString()??string.Empty).DataSource;if(!string.IsNullOrWhiteSpace(dataSource)){sqliteLocation=System.IO.Path.IsPathRooted(dataSource)?System.IO.Path.GetFullPath(dataSource):System.IO.Path.GetFullPath(dataSource,HostEnvironment.ContentRootPath);}}var controller=ViewContext.RouteData.Values["controller"]?.ToString();var action=ViewContext.RouteData.Values["action"]?.ToString();}
<!DOCTYPE html><html lang="pt-PT"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - Tabularius AI</title><link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/version.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/import.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/lists.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/table-actions.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/operation-progress.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/contextbar.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/user-menu.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/users.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/fixed-shell.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/page-titles.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/accounting-entry.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/trial-balance.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/income-statement.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/balance-sheet.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/cookie-consent.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/ai-settings.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/ai-chat.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/dossier.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/preferences.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/theme-purple.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/toasts.css" asp-append-version="true"/></head><body class="app-body"><div class="app-shell"><header class="app-header"><div class="brand-area"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">T</span><span>Tabularius AI</span><small class="version-badge">v@(AppInfo.Version)</small></a><span class="brand-description">@AppInfo.Description</span></div>@if(User.Identity?.IsAuthenticated==true){<div class="topbar-actions"><details class="user-menu"><summary><span class="user-avatar">@userInitial</span><span class="user-identity"><strong>@userName</strong></span><svg viewBox="0 0 20 20"><path d="m5 7.5 5 5 5-5"/></svg></summary><div class="user-dropdown"><div class="user-dropdown-heading"><span class="user-avatar">@userInitial</span><div><strong>@userName</strong><small>@userIdentifier</small></div></div><a class="user-dropdown-action" asp-controller="Account" asp-action="Preferences"><span>⚙</span> Preferências</a><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="user-dropdown-action"><span>↪</span> Terminar sessão</button></form></div></details></div>}</header><aside class="sidebar" aria-label="Navegação principal"><nav><div class="nav-primary"><a class="nav-item @(controller=="Home"&&action=="Index"?"active":"")" asp-controller="Home" asp-action="Index"><span class="nav-icon" aria-hidden="true">⌂</span><span class="nav-copy"><strong>Início</strong><small>Visão geral</small></span></a><a class="nav-item @(controller=="Dossier"?"active":"")" asp-controller="Dossier" asp-action="Entities"><span class="nav-icon" aria-hidden="true">▤</span><span class="nav-copy"><strong>Dossiers</strong><small>Entidades e exercícios</small></span></a></div><p class="nav-heading">Operações</p><a class="nav-item nav-item-compact @(controller=="Home"&&action=="Import"?"active":"")" asp-controller="Home" asp-action="Import"><span class="nav-icon" aria-hidden="true">⇧</span><span class="nav-copy"><strong>Importar SAF-T</strong><small>Novo ficheiro PT</small></span></a><a class="nav-item nav-item-compact @(controller=="Dossier"&&action=="RestoreBackup"?"active":"")" asp-controller="Dossier" asp-action="RestoreBackup"><span class="nav-icon" aria-hidden="true">↺</span><span class="nav-copy"><strong>Restaurar backup</strong><small>Dossier em JSON</small></span></a>@if(aiEnabled){<p class="nav-heading">Inteligência</p><a class="nav-item nav-item-compact @(controller=="AiAssistant"?"active":"")" asp-controller="Dossier" asp-action="Entities"><span class="nav-icon nav-icon-ai" aria-hidden="true">✦</span><span class="nav-copy"><strong>Assistente AI</strong><small>Escolher um dossier</small></span></a>}@if(User.IsInRole(ApplicationRoles.Administrator)){<p class="nav-heading">Administração</p><a class="nav-item nav-item-compact @(controller=="Users"?"active":"")" asp-controller="Users" asp-action="Index"><span class="nav-icon" aria-hidden="true">♙</span><span class="nav-copy"><strong>Utilizadores</strong><small>Acessos e funções</small></span></a><a class="nav-item nav-item-compact @(controller=="AiSettings"?"active":"")" asp-controller="AiSettings" asp-action="Index"><span class="nav-icon nav-icon-ai" aria-hidden="true">✦</span><span class="nav-copy"><strong>Configuração AI</strong><small>Fornecedor e modelo</small></span></a>}<div class="nav-context-note"><span class="nav-context-icon">→</span><div><strong>Área de trabalho</strong><span>Selecione um dossier para aceder aos dados SAF-T, análise contabilística e área analítica.</span></div></div></nav></aside><main class="app-content">@RenderBody()</main><footer class="contextbar"><span class="context-item context-copyright context-with-tooltip" tabindex="0"><span class="context-copyright-icon">©</span> @DateTime.Today.Year Tabularius AI · Rui Ribeiro · Licença MIT<span class="context-tooltip context-tooltip-left"><strong>Sobre o projeto</strong><span><small>Aplicação</small><b>Tabularius AI</b></span><span><small>Autor</small><b>Rui Ribeiro</b></span><span><small>Licença</small><b>MIT · Open source</b></span><span><small>Repositório</small><b>ruialexrib/tabularius-ai</b></span></span></span><span class="context-spacer"></span><span class="context-item context-with-tooltip" tabindex="0"><span class="context-status-dot @(aiEnabled?"":"context-status-off")"></span> AI: @(aiEnabled?"Ativa":"Desativada")@(aiEnabled?$" · {aiSettings!.Provider} · {aiSettings.Model}":"")<span class="context-tooltip"><strong>Inteligência Artificial</strong><span><small>Estado</small><b>@(aiEnabled?"Ativa":"Desativada")</b></span>@if(aiSettings is not null){<span><small>Fornecedor</small><b>@aiSettings.Provider</b></span><span><small>Modelo</small><b>@aiSettings.Model</b></span>}</span></span><span class="context-item context-with-tooltip" tabindex="0"><span class="context-status-dot"></span> Base de dados: Online@(isSqlite?" · SQLite":"")<span class="context-tooltip context-tooltip-database"><strong>Base de dados</strong><span><small>Estado</small><b class="tooltip-online">● Online</b></span><span><small>Motor</small><b>@(isSqlite?"SQLite":"SQL Server")</b></span>@if(isSqlite&&sqliteLocation is not null){<span><small>Localização</small><b>@sqliteLocation</b></span>}<span><small>Persistência</small><b>Dados da aplicação</b></span></span></span><span class="context-item context-with-tooltip" tabindex="0"><span class="context-icon">v</span> v@(AppInfo.Version)<span class="context-tooltip context-tooltip-right"><strong>Versão da aplicação</strong><span><small>Tabularius AI</small><b>v@(AppInfo.Version)</b></span><span><small>Ambiente</small><b>@HostEnvironment.EnvironmentName</b></span><span><small>Runtime</small><b>@RuntimeInformation.FrameworkDescription</b></span><span><small>Execução</small><b>@(Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER")=="true"?"Docker":"Host local")</b></span></span></span></footer></div>@if(currentUser?.CookieConsentAcceptedAt is null && User.Identity?.IsAuthenticated==true){<partial name="_CookieConsent" model="currentUser"/>}<div class="app-toast-stack" aria-live="polite" aria-atomic="true">@if(TempData["SuccessMessage"] is string toastSuccess){<aside class="app-toast app-toast-success" data-app-toast role="status"><span class="app-toast-icon" aria-hidden="true">✓</span><div class="app-toast-copy"><strong>Operação concluída</strong><p>@toastSuccess</p></div><button type="button" class="app-toast-close" data-toast-close aria-label="Fechar notificação">×</button><span class="app-toast-progress" aria-hidden="true"></span></aside>}@if(TempData["WarningMessage"] is string toastWarning){<aside class="app-toast app-toast-warning" data-app-toast role="status"><span class="app-toast-icon" aria-hidden="true">!</span><div class="app-toast-copy"><strong>Atenção</strong><p>@toastWarning</p></div><button type="button" class="app-toast-close" data-toast-close aria-label="Fechar notificação">×</button><span class="app-toast-progress" aria-hidden="true"></span></aside>}@if(TempData["ErrorMessage"] is string toastError){<aside class="app-toast app-toast-error" data-app-toast role="alert"><span class="app-toast-icon" aria-hidden="true">!</span><div class="app-toast-copy"><strong>Não foi possível concluir</strong><p>@toastError</p></div><button type="button" class="app-toast-close" data-toast-close aria-label="Fechar notificação">×</button><span class="app-toast-progress" aria-hidden="true"></span></aside>}</div><div class="operation-progress" data-operation-progress aria-hidden="true" aria-live="polite"><div class="operation-progress-card"><span class="operation-spinner"></span><div class="operation-progress-copy"><small>Tabularius AI</small><strong>A processar o pedido</strong><p>Aguarde enquanto preparamos a informação.</p></div></div></div><script src="~/js/operation-progress.js" asp-append-version="true"></script><script src="~/js/toasts.js" asp-append-version="true"></script><script src="~/js/ai-markdown.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
