@model TabulariusAI.Web.Models.AiSettingsViewModel
@{ViewData["Title"]="Inteligência Artificial";}
<div class="ai-settings-page"><div class="ai-settings-card"><section class="ai-settings-main"><div class="ai-settings-heading"><div class="ai-settings-icon">AI</div><div><span class="eyebrow">Administração</span><h1>Inteligência Artificial</h1><p>Configure o modelo, o fornecedor e as instruções utilizadas pelo assistente do Tabularius AI.</p></div></div>
@if(TempData["AiSettingsSaved"] is string message){<div class="ai-settings-success"><span>✓</span><div><strong>Definições atualizadas</strong><small>@message</small></div></div>}@if(TempData["AiSettingsTest"] is string testMessage){<div class="ai-settings-success"><span>✓</span><div><strong>Modelo compatível</strong><small>@testMessage</small></div></div>}@if(TempData["AiSettingsError"] is string errorMessage){<div class="ai-settings-alert"><span>!</span><div><strong>Modelo incompatível ou indisponível</strong><small>@errorMessage</small></div></div>}
<form method="post" class="ai-settings-form"><div asp-validation-summary="ModelOnly" class="ai-settings-errors"></div><section class="ai-settings-section"><div class="ai-settings-section-title"><span>01</span><div><strong>Estado do assistente</strong><small>Controle se as funcionalidades de inteligência artificial estão disponíveis.</small></div></div><label class="ai-toggle"><input asp-for="IsEnabled"/><span class="ai-toggle-track"><span></span></span><span><strong>Ativar assistente AI</strong><small>Permitir consultas aos dados através do modelo configurado.</small></span></label></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>02</span><div><strong>Modelo e fornecedor</strong></div></div><div class="ai-settings-grid"><div class="ai-field"><label asp-for="Provider">Fornecedor</label><select asp-for="Provider" id="aiProvider"><option>Ollama</option><option>Mistral</option></select></div><div class="ai-field"><label asp-for="Model">Modelo</label><input asp-for="Model"/></div><div class="ai-field ai-field-wide"><label asp-for="Endpoint">Endpoint</label><input asp-for="Endpoint" id="aiEndpoint"/></div><div class="ai-field"><label asp-for="Temperature">Temperatura</label><input asp-for="Temperature" step="0.1"/></div><div class="ai-field"><label asp-for="TimeoutSeconds">Timeout</label><input asp-for="TimeoutSeconds"/></div></div></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>03</span><div><strong>Autenticação</strong></div></div><div class="ai-field"><label asp-for="ApiKey">API key</label><input asp-for="ApiKey" type="password" placeholder="@(Model.HasApiKey?"Chave configurada — deixe vazio para manter":"Introduza a chave da API")"/></div></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>04</span><div><strong>System prompt</strong></div></div><div class="ai-prompt-wrap"><textarea asp-for="SystemPrompt" rows="13"></textarea></div></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>05</span><div><strong>Mensagem inteligente da página inicial</strong></div></div><div class="ai-prompt-wrap"><textarea asp-for="HomePrompt" rows="4"></textarea></div><div class="ai-field" style="margin-top:14px"><label asp-for="HomeCacheMinutes">Atualizar mensagem a cada</label><input asp-for="HomeCacheMinutes"/></div></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>06</span><div><strong>Relatórios analíticos</strong><small>Cada subárea usa uma instrução própria sobre contexto calculado deterministicamente pela aplicação.</small></div></div>
@foreach(var item in new[]{("AnalyticsOverviewPrompt","Área analítica · Visão geral"),("AnomaliesPrompt","Área analítica · Anomalias"),("AccountAnalysisPrompt","Área analítica · Análise de contas"),("VatAnalysisPrompt","Área analítica · Análise de IVA"),("TrialBalancePrompt","Análise contabilística · Balancete"),("IncomeStatementPrompt","Análise contabilística · Demonstração de Resultados"),("BalanceSheetPrompt","Análise contabilística · Balanço")}){<div class="ai-prompt-wrap" style="margin-top:14px"><div class="ai-prompt-toolbar"><span>@item.Item2</span><span>AI REPORT</span></div><textarea name="@item.Item1" rows="4" maxlength="2000">@Model.GetType().GetProperty(item.Item1)!.GetValue(Model)</textarea></div>}
<div class="ai-prompt-note"><span>i</span><p><strong>O modelo interpreta; a aplicação calcula.</strong><small>Os relatórios recebem apenas contexto determinístico da respetiva página.</small></p></div></section><div class="ai-settings-actions"><button class="btn btn-primary" type="submit">Guardar definições</button></div></form>
<section class="ai-settings-test"><div><p><strong>Testar compatibilidade do modelo</strong><small>Confirma endpoint, autenticação, disponibilidade e tool calling.</small></p></div><form asp-action="TestConnection" method="post"><button class="btn btn-secondary" type="submit">Testar compatibilidade</button></form></section></section><aside class="ai-settings-aside"><span class="ai-aside-label">Configuração AI</span><h2>Modelo desacoplado dos dados.</h2><p>O modelo interpreta contexto determinístico produzido pela aplicação.</p></aside></div></div>
