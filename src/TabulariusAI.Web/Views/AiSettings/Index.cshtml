@model TabulariusAI.Web.Models.AiSettingsViewModel
@{ViewData["Title"]="Inteligência Artificial";}
<div class="ai-settings-page"><div class="ai-settings-card"><section class="ai-settings-main">
<div class="ai-settings-heading"><div class="ai-settings-icon">AI</div><div><span class="eyebrow">Administração</span><h1>Inteligência Artificial</h1><p>Configure o modelo, o fornecedor e as instruções utilizadas pelo assistente do Tabularius AI.</p></div></div>
@if(TempData["AiSettingsSaved"] is string message){<div class="ai-settings-success"><span>✓</span><div><strong>Definições atualizadas</strong><small>@message</small></div></div>}@if(TempData["AiSettingsTest"] is string testMessage){<div class="ai-settings-success"><span>✓</span><div><strong>Modelo compatível</strong><small>@testMessage</small></div></div>}@if(TempData["AiSettingsError"] is string errorMessage){<div class="ai-settings-alert"><span>!</span><div><strong>Modelo incompatível ou indisponível</strong><small>@errorMessage</small></div></div>}
<form method="post" class="ai-settings-form"><div asp-validation-summary="ModelOnly" class="ai-settings-errors"></div>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>01</span><div><strong>Estado do assistente</strong><small>Controle se as funcionalidades de inteligência artificial estão disponíveis.</small></div></div><label class="ai-toggle"><input asp-for="IsEnabled"/><span class="ai-toggle-track"><span></span></span><span><strong>Ativar assistente AI</strong><small>Permitir consultas aos dados através do modelo configurado.</small></span></label></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>02</span><div><strong>Modelo e fornecedor</strong><small>Escolha entre execução local com Ollama ou um modelo remoto através da Mistral.</small></div></div><div class="ai-settings-grid"><div class="ai-field"><label asp-for="Provider">Fornecedor</label><select asp-for="Provider" id="aiProvider"><option>Ollama</option><option>Mistral</option></select></div><div class="ai-field"><label asp-for="Model">Modelo</label><input asp-for="Model" placeholder="Ex.: mistral-small-latest ou qwen3:4b"/></div><div class="ai-field ai-field-wide"><label asp-for="Endpoint">Endpoint</label><input asp-for="Endpoint" id="aiEndpoint"/><small id="aiEndpointHint">URL base da API do fornecedor selecionado.</small></div><div class="ai-field"><label asp-for="Temperature">Temperatura</label><input asp-for="Temperature" step="0.1" min="0" max="2"/></div><div class="ai-field"><label asp-for="TimeoutSeconds">Timeout</label><div class="ai-input-suffix"><input asp-for="TimeoutSeconds"/><span>seg.</span></div></div></div></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>03</span><div><strong>Autenticação</strong><small>Credenciais necessárias apenas para fornecedores remotos.</small></div></div><div class="ai-field"><label asp-for="ApiKey">API key</label><input asp-for="ApiKey" type="password" placeholder="@(Model.HasApiKey?"Chave configurada — deixe vazio para manter":"Introduza a chave da API")" autocomplete="new-password"/></div></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>04</span><div><strong>System prompt</strong><small>Defina as regras permanentes de comportamento do assistente.</small></div></div><div class="ai-prompt-wrap"><div class="ai-prompt-toolbar"><span>Instruções do sistema</span><span>PT-PT</span></div><textarea asp-for="SystemPrompt" rows="13"></textarea></div><span asp-validation-for="SystemPrompt" class="field-validation-error"></span></section>
<section class="ai-settings-section"><div class="ai-settings-section-title"><span>05</span><div><strong>Mensagem inteligente da página inicial</strong><small>Configure a geração e a frequência de atualização do resumo contextual do dashboard.</small></div></div><div class="ai-prompt-wrap"><div class="ai-prompt-toolbar"><span>Instrução para o modelo</span><span>HOME AI</span></div><textarea asp-for="HomePrompt" rows="4" maxlength="500"></textarea></div><span asp-validation-for="HomePrompt" class="field-validation-error"></span><div class="ai-field" style="margin-top:14px;max-width:260px"><label asp-for="HomeCacheMinutes">Atualizar mensagem a cada</label><div class="ai-input-suffix"><input asp-for="HomeCacheMinutes" min="1" max="10080"/><span>min.</span></div><small>1 minuto a 7 dias. Valor recomendado: 60 minutos.</small></div><div class="ai-prompt-note"><span>i</span><p><strong>O texto acima é uma instrução, não a mensagem apresentada.</strong><small>O modelo recebe esta instrução juntamente com um resumo determinístico dos dossiers. A resposta gerada permanece em cache durante o período configurado; alterações aos dados ou às Settings geram automaticamente uma nova mensagem.</small></p></div></section>
<div class="ai-settings-actions"><button class="btn btn-primary" type="submit">Guardar definições</button></div></form>
<section class="ai-settings-test"><div><span class="ai-test-icon">↗</span><p><strong>Testar compatibilidade do modelo</strong><small>Confirma endpoint, autenticação, disponibilidade do modelo e suporte a tool calling.</small></p></div><form asp-action="TestConnection" method="post"><button class="btn btn-secondary" type="submit">Testar compatibilidade</button></form></section>
</section><aside class="ai-settings-aside"><span class="ai-aside-label">Configuração AI</span><h2>Modelo desacoplado dos dados.</h2><p>O assistente comunica com os dados persistidos exclusivamente através de tools controladas pela aplicação.</p><div class="ai-provider-flow"><div><span>1</span><p><strong>Utilizador</strong><small>Faz uma pergunta sobre o dossier.</small></p></div><i></i><div><span>2</span><p><strong>Modelo AI</strong><small>Seleciona a tool necessária.</small></p></div><i></i><div><span>3</span><p><strong>Tabularius</strong><small>Consulta e devolve dados reais.</small></p></div></div><div class="ai-aside-status"><span class="ai-status-dot"></span><div><strong>@(Model.IsEnabled?"Assistente ativo":"Assistente inativo")</strong><small>@Model.Provider · @Model.Model</small></div></div></aside></div></div>
<script>(()=>{const provider=document.getElementById('aiProvider'),endpoint=document.getElementById('aiEndpoint'),hint=document.getElementById('aiEndpointHint');if(!provider||!endpoint)return;const defaults={Ollama:'http://localhost:11434',Mistral:'https://api.mistral.ai/'};const hints={Ollama:'URL sugerido para uma instalação local do Ollama.',Mistral:'URL sugerido para a API oficial da Mistral.'};let previousProvider=provider.value;provider.addEventListener('change',()=>{const previousDefault=defaults[previousProvider];if(!endpoint.value.trim()||endpoint.value.trim()===previousDefault||Object.values(defaults).includes(endpoint.value.trim()))endpoint.value=defaults[provider.value]??'';if(hint)hint.textContent=hints[provider.value]??'URL base da API do fornecedor selecionado.';previousProvider=provider.value;});})();</script>
