@model TabulariusAI.Web.Models.AiSettingsViewModel
@{ViewData["Title"]="Inteligência Artificial";}
<div class="page-title"><div><span class="eyebrow">Administração</span><h1>Inteligência Artificial</h1><p>Configure o modelo utilizado pelo assistente e as instruções que regulam as respostas.</p></div></div>
@if(TempData["AiSettingsSaved"] is string message){<div class="alert alert-success">@message</div>}
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label><input asp-for="IsEnabled"/> Ativar assistente AI</label><div class="form-grid"><div><label asp-for="Provider">Provider</label><select asp-for="Provider"><option>Ollama</option><option>Mistral</option></select></div><div><label asp-for="Model">Modelo</label><input asp-for="Model"/></div><div><label asp-for="Endpoint">Endpoint</label><input asp-for="Endpoint"/></div><div><label asp-for="TimeoutSeconds">Timeout (segundos)</label><input asp-for="TimeoutSeconds"/></div><div><label asp-for="Temperature">Temperatura</label><input asp-for="Temperature" step="0.1"/></div><div><label asp-for="ApiKey">API key</label><input asp-for="ApiKey" placeholder="@(Model.HasApiKey?"Configurada — deixe vazio para manter":"Necessária para Mistral")" autocomplete="new-password"/></div></div><div><label asp-for="SystemPrompt">System prompt</label><textarea asp-for="SystemPrompt" rows="12"></textarea><span asp-validation-for="SystemPrompt" class="text-danger"></span></div><div class="form-actions"><button class="btn btn-primary" type="submit">Guardar definições</button></div></form>
