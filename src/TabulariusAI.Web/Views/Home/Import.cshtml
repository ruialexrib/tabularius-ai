@model TabulariusAI.Web.Models.SaftHeaderViewModel?
@{
    ViewData["Title"] = "Importar SAF-T (PT)";
    var hasErrors = !ViewData.ModelState.IsValid;
}

<section class="import-page" aria-labelledby="import-title">
    <div class="import-card">
        <div class="import-card-main">
            <div class="import-icon" aria-hidden="true">XML</div>
            <div class="import-copy">
                <p class="eyebrow">Nova fonte contabilística</p>
                <h1 id="import-title">Importar SAF-T (PT)</h1>
                <p class="lead">Selecione o ficheiro SAF-T (PT) que pretende adicionar. A entidade, o exercício e o período são identificados automaticamente a partir do conteúdo.</p>

                @if (hasErrors)
                {
                    <div class="import-alert import-alert-error" role="alert">
                        <span class="import-alert-icon" aria-hidden="true">!</span>
                        <div>
                            <strong>Não foi possível importar o ficheiro</strong>
                            <div asp-validation-summary="All" class="import-alert-details"></div>
                        </div>
                    </div>
                }
                else if (Model is not null)
                {
                    <div class="import-alert import-alert-success" role="status">
                        <span class="import-alert-icon" aria-hidden="true">✓</span>
                        <div>
                            <strong>Ficheiro importado com sucesso</strong>
                            <p>@(TempData["SaftImportValidation"] ?? "Os dados foram adicionados ao respetivo dossier contabilístico.")</p>
                        </div>
                    </div>
                }

                <form asp-controller="Home" asp-action="UploadSaft" method="post" enctype="multipart/form-data" class="import-form" id="saftImportForm">
                    <label class="import-file-picker" for="saftFile" id="saftFilePicker">
                        <span class="import-file-picker-icon" aria-hidden="true">+</span>
                        <span class="import-file-picker-copy">
                            <strong id="saftFileTitle">Selecionar ficheiro SAF-T (PT)</strong>
                            <span id="saftFileMeta">Ficheiro XML até 100 MB</span>
                        </span>
                        <span class="import-file-change" id="saftFileChange" hidden>Alterar</span>
                        <input id="saftFile" name="saftFile" type="file" accept=".xml,text/xml,application/xml" />
                    </label>

                    <div class="import-actions">
                        <button type="submit" class="btn btn-primary" id="saftSubmitButton">Importar ficheiro</button>
                        <a class="btn btn-secondary" asp-controller="Dossier" asp-action="Entities">Ver entidades e exercícios</a>
                    </div>
                </form>
            </div>
        </div>

        <aside class="import-reference" aria-label="Processo de importação">
            <span class="import-reference-label">Processo de importação</span>
            <h2>Leitura automática</h2>
            <p>O Tabularius identifica a informação essencial do ficheiro antes de a adicionar ao dossier contabilístico.</p>

            <div class="import-checks">
                <div><span>1</span><p><strong>Ficheiro XML</strong><small>Verificação do formato de ficheiro.</small></p></div>
                <div><span>2</span><p><strong>Leitura SAF-T (PT)</strong><small>Identificação da entidade, exercício, período e dados disponíveis.</small></p></div>
                <div><span>3</span><p><strong>Duplicados</strong><small>O mesmo ficheiro não é importado duas vezes.</small></p></div>
                <div><span>4</span><p><strong>Importação</strong><small>Os dados são associados ao respetivo dossier contabilístico.</small></p></div>
            </div>

            <div class="import-reference-note">
                <strong>Dados contabilísticos</strong>
                <span>Confirme que selecionou o ficheiro correto antes de iniciar a importação.</span>
            </div>
        </aside>
    </div>
</section>

@if (Model is not null)
{
    <section class="result-card import-result">
        <div class="card-header">
            <div>
                <p class="section-kicker">Importação concluída</p>
                <h2>@Model.CompanyName · @Model.FiscalYear</h2>
                <p>@Model.StartDate — @Model.EndDate · SAF-T (PT) @Model.SaftVersion</p>
            </div>
            <span class="status-pill status-pill-success">Importado</span>
        </div>
    </section>
}

@section Scripts {
<script>
    (() => {
        const input = document.getElementById('saftFile');
        const picker = document.getElementById('saftFilePicker');
        const title = document.getElementById('saftFileTitle');
        const meta = document.getElementById('saftFileMeta');
        const change = document.getElementById('saftFileChange');
        const form = document.getElementById('saftImportForm');
        const submit = document.getElementById('saftSubmitButton');

        input?.addEventListener('change', () => {
            const file = input.files?.[0];
            if (!file) {
                picker?.classList.remove('has-file');
                title.textContent = 'Selecionar ficheiro SAF-T (PT)';
                meta.textContent = 'Ficheiro XML até 100 MB';
                change.hidden = true;
                return;
            }

            picker?.classList.add('has-file');
            title.textContent = file.name;
            meta.textContent = `${formatFileSize(file.size)} · XML selecionado`;
            change.hidden = false;
        });

        form?.addEventListener('submit', () => {
            if (!input.files?.length) return;
            submit.disabled = true;
            submit.textContent = 'A importar…';
        });

        function formatFileSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        }
    })();
</script>
}
