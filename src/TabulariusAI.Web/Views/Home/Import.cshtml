@model TabulariusAI.Web.Models.SaftHeaderViewModel?
@{ ViewData["Title"] = "Importar SAF-T (PT)"; }
<section class="page-header"><div><p class="eyebrow">Fontes contabilísticas</p><h1>Importar SAF-T (PT)</h1><p class="lead">Adicione uma fonte SAF-T (PT). A entidade e o exercício são identificados a partir do próprio ficheiro.</p></div><a class="btn btn-secondary" asp-controller="Dossier" asp-action="Entities">Ver entidades</a></section>
<section class="form-card" aria-labelledby="upload-title"><div class="card-header"><div><p class="section-kicker">Nova fonte</p><h2 id="upload-title">Ficheiro SAF-T (PT)</h2><p>Selecione um ficheiro XML SAF-T (PT). Antes da importação, o documento é validado contra o XSD oficial SAF-T (PT) 1.04_01.</p></div></div><form asp-controller="Home" asp-action="UploadSaft" method="post" enctype="multipart/form-data" class="upload-form"><div class="form-field form-field-grow"><label for="saftFile">Selecionar ficheiro</label><div class="file-control"><input id="saftFile" name="saftFile" type="file" accept=".xml,text/xml,application/xml" /></div><span class="field-help">XML · tamanho máximo 100 MB · validação XSD obrigatória</span></div><div class="form-actions"><button type="submit" class="btn btn-primary">Validar e importar</button></div><div asp-validation-summary="All" class="validation-summary"></div></form></section>
@if (Model is not null) { <section class="result-card"><div class="card-header"><div><p class="section-kicker">Ficheiro importado</p><h2>@Model.CompanyName · @Model.FiscalYear</h2><p>@Model.StartDate — @Model.EndDate · SAF-T (PT) @Model.SaftVersion</p><p class="status-message status-success">@(TempData["SaftImportValidation"] ?? "Ficheiro válido segundo o XSD oficial SAF-T (PT) 1.04_01.")</p></div><span class="status-pill status-pill-success">XSD válido · Importado</span></div></section> }
