@using System.Globalization
@using TabulariusAI.Web.Services
@inject IHomeDashboardService DashboardService
@{ViewData["Title"]="Início";var dashboard=await DashboardService.GetAsync(Context.RequestAborted);var maxTransactions=Math.Max(1,dashboard.Evolution.Select(x=>x.Transactions).DefaultIfEmpty(0).Max());var maxSales=Math.Max(1m,dashboard.Evolution.Select(x=>x.GrossSales).DefaultIfEmpty(0m).Max());}
<section class="dashboard-hero"><div class="dashboard-hero-copy"><p class="eyebrow">Workspace contabilístico</p><h1>Dados contabilísticos.<br><span>Análise com contexto.</span></h1><p class="dashboard-hero-lead">Centralize os dossiers SAF-T (PT), acompanhe os principais indicadores e avance diretamente para a análise do exercício.</p><div class="dashboard-actions"><a class="btn btn-primary" asp-controller="Dossier" asp-action="Entities">Abrir dossiers <span>→</span></a><a class="btn btn-secondary" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a></div></div><div class="dashboard-hero-status"><div class="dashboard-status-mark">T</div><div><small>Tabularius AI</small><strong>@dashboard.Entities entidades · @dashboard.Dossiers dossiers</strong><span>@dashboard.Imports importações disponíveis para análise</span></div></div></section>
<section class="dashboard-overview"><div class="dashboard-section-heading"><div><p class="section-kicker">Visão geral</p><h2>O essencial, num só lugar</h2></div><span>Dados consolidados dos dossiers</span></div><div class="dashboard-kpis" aria-label="Indicadores da aplicação"><article><span class="kpi-icon">EN</span><div><small>Entidades</small><strong>@dashboard.Entities</strong><p>entidades contabilísticas</p></div></article><article><span class="kpi-icon">DS</span><div><small>Dossiers</small><strong>@dashboard.Dossiers</strong><p>exercícios disponíveis</p></div></article><article><span class="kpi-icon">IM</span><div><small>Importações</small><strong>@dashboard.Imports</strong><p>ficheiros SAF-T persistidos</p></div></article><article><span class="kpi-icon">CT</span><div><small>Contas</small><strong>@dashboard.Accounts.ToString("N0",CultureInfo.GetCultureInfo("pt-PT"))</strong><p>registos contabilísticos</p></div></article><article><span class="kpi-icon">MV</span><div><small>Transações</small><strong>@dashboard.Transactions.ToString("N0",CultureInfo.GetCultureInfo("pt-PT"))</strong><p>movimentos disponíveis</p></div></article><article class="kpi-emphasis"><span class="kpi-icon">€</span><div><small>Vendas</small><strong>@dashboard.GrossSales.ToString("N2",CultureInfo.GetCultureInfo("pt-PT")) €</strong><p>@dashboard.SalesDocuments documentos</p></div></article></div></section>
@if(dashboard.AiEnabled){<section class="dashboard-ai"><div class="dashboard-ai-mark">✦</div><div class="dashboard-ai-copy"><div class="dashboard-ai-meta"><span>Assistente AI ativo</span><i></i><span>@dashboard.AiProvider · @dashboard.AiModel</span></div><h2>Uma leitura rápida dos dados disponíveis.</h2><p class="dashboard-ai-next"><span>Gerado por AI</span>@dashboard.AiWelcomeMessage</p>@if(dashboard.DossierSummaries.Count>0){<div class="dashboard-dossiers">@foreach(var dossier in dashboard.DossierSummaries){<a asp-controller="Dossier" asp-action="Details" asp-route-id="@dossier.Id"><span><strong>@dossier.Entity</strong><small>@dossier.Name · @dossier.FiscalYear</small></span><span class="dossier-mini"><b>@dossier.Transactions</b> movimentos · <b>@dossier.SalesDocuments</b> vendas</span><i>›</i></a>}</div>}</div></section>}else{<section class="dashboard-ai dashboard-ai-disabled"><div class="dashboard-ai-mark">✦</div><div class="dashboard-ai-copy"><div class="dashboard-ai-meta"><span>Assistente AI não configurado</span></div><h2>Transforme os dados contabilísticos numa experiência conversacional.</h2><p class="dashboard-ai-disabled-lead">Ative a Inteligência Artificial nas definições para analisar os dossiers através de linguagem natural, mantendo o acesso aos dados controlado pelas tools do Tabularius AI.</p><div class="dashboard-ai-benefits"><div><span>01</span><p><strong>Pergunte pelos dados</strong><small>Consulte balancetes, contas, vendas, clientes, fornecedores, produtos, impostos e movimentos sem procurar manualmente em cada lista.</small></p></div><div><span>02</span><p><strong>Respostas fundamentadas</strong><small>O modelo utiliza tools de leitura controladas pela aplicação para obter os dados persistidos do dossier.</small></p></div><div><span>03</span><p><strong>Análise mais rápida</strong><small>Obtenha resumos e interpretações dos dados disponíveis e identifique mais depressa o que merece análise.</small></p></div></div><div class="dashboard-ai-disabled-actions"><a class="btn btn-primary" asp-controller="AiSettings" asp-action="Index">Configurar Inteligência Artificial</a><span>Pode utilizar Ollama localmente ou um fornecedor remoto suportado.</span></div></div></section>}
<section class="dashboard-analysis"><div class="dashboard-section-heading"><div><p class="section-kicker">Evolução</p><h2>Perspetiva por exercício</h2></div><span>Volume contabilístico e comercial</span></div><div class="dashboard-chart-grid"><article class="dashboard-chart"><header><div><span class="chart-number">01</span><div><small>Atividade contabilística</small><h3>Transações por exercício</h3></div></div><strong>@dashboard.Transactions.ToString("N0",CultureInfo.GetCultureInfo("pt-PT")) <small>total</small></strong></header><div class="bar-chart">@if(dashboard.Evolution.Count==0){<p class="chart-empty">Ainda não existem dados suficientes.</p>}else{@foreach(var point in dashboard.Evolution){var height=Math.Max(4,(double)point.Transactions/maxTransactions*100);<div class="bar-item"><div class="bar-value">@point.Transactions.ToString("N0",CultureInfo.GetCultureInfo("pt-PT"))</div><div class="bar-track"><span style="height:@height.ToString("0.##",CultureInfo.InvariantCulture)%"></span></div><small>@point.FiscalYear</small></div>}}</div></article><article class="dashboard-chart"><header><div><span class="chart-number">02</span><div><small>Atividade comercial</small><h3>Vendas brutas por exercício</h3></div></div><strong>@dashboard.GrossSales.ToString("N2",CultureInfo.GetCultureInfo("pt-PT")) € <small>total</small></strong></header><div class="bar-chart">@if(dashboard.Evolution.Count==0){<p class="chart-empty">Ainda não existem dados suficientes.</p>}else{@foreach(var point in dashboard.Evolution){var height=Math.Max(4,(double)(point.GrossSales/maxSales)*100);<div class="bar-item"><div class="bar-value">@point.GrossSales.ToString("N0",CultureInfo.GetCultureInfo("pt-PT")) €</div><div class="bar-track"><span style="height:@height.ToString("0.##",CultureInfo.InvariantCulture)%"></span></div><small>@point.FiscalYear</small></div>}}</div></article></div></section>
