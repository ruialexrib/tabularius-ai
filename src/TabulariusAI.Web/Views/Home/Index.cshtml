@{
    ViewData["Title"] = "Início";
}

<section class="home-hero">
    <div class="home-hero-copy">
        <p class="eyebrow">Workspace contabilístico</p>
        <h1>Dos dados contabilísticos<br /><span>à análise.</span></h1>
        <p class="lead">Explore SAF-T (PT), organize dossiers e transforme informação contabilística em análises claras, rastreáveis e prontas para apoiar o trabalho diário.</p>
        <div class="home-actions">
            <a class="btn btn-primary" asp-controller="Dossier" asp-action="Entities">Abrir entidades</a>
            <a class="btn btn-secondary" asp-controller="Home" asp-action="Import">Importar SAF-T (PT)</a>
        </div>
        <div class="home-principles" aria-label="Princípios da aplicação">
            <span>Local-first</span>
            <span>Cálculo determinístico</span>
            <span>IA assistida</span>
        </div>
    </div>

    <aside class="home-hero-visual" aria-label="Fluxo de análise contabilística">
        <div class="home-visual-topline">
            <span class="home-live-dot"></span>
            <span>Workspace</span>
            <small>SAF-T (PT)</small>
        </div>
        <div class="home-visual-company">
            <span class="home-company-mark">T</span>
            <div><strong>Entidade contabilística</strong><small>Exercício e fontes de dados</small></div>
        </div>
        <div class="home-visual-grid">
            <div><small>Balancete</small><strong>Contas</strong><span>Débito · Crédito · Saldo</span></div>
            <div><small>Razão</small><strong>Movimentos</strong><span>Lançamentos e detalhe</span></div>
            <div><small>Resultados</small><strong>Análise</strong><span>Rendimentos e gastos</span></div>
            <div class="home-visual-accent"><small>Assistente</small><strong>AI</strong><span>Interpretação contextual</span></div>
        </div>
        <div class="home-visual-footer"><span>Fonte selecionada</span><strong>Período contabilístico ativo</strong></div>
    </aside>
</section>

<section class="home-section-heading">
    <div><p class="section-kicker">Explorar</p><h2>Um espaço de trabalho, várias perspetivas</h2></div>
    <p>Comece pela entidade e mantenha sempre o contexto do exercício e da fonte contabilística que está a analisar.</p>
</section>

<section class="home-capabilities home-capabilities-modern" aria-label="Áreas da aplicação">
    <article>
        <span class="home-feature-number">01</span>
        <div class="home-feature-icon">EN</div>
        <h2>Entidades e dossiers</h2>
        <p>Organize empresas, exercícios e importações numa estrutura simples e rastreável.</p>
        <a asp-controller="Dossier" asp-action="Entities">Explorar entidades <b>→</b></a>
    </article>
    <article>
        <span class="home-feature-number">02</span>
        <div class="home-feature-icon">ST</div>
        <h2>SAF-T (PT)</h2>
        <p>Consulte contas, clientes, fornecedores, produtos, documentos e movimentos contabilísticos.</p>
        <a asp-controller="Home" asp-action="Import">Importar ficheiro <b>→</b></a>
    </article>
    <article>
        <span class="home-feature-number">03</span>
        <div class="home-feature-icon">AN</div>
        <h2>Análise contabilística</h2>
        <p>Trabalhe com balancetes, razão, resultados e outras análises sobre dados persistidos.</p>
        <a asp-controller="Dossier" asp-action="Entities">Abrir workspace <b>→</b></a>
    </article>
    <article>
        <span class="home-feature-number">04</span>
        <div class="home-feature-icon">AI</div>
        <h2>Inteligência assistida</h2>
        <p>Acrescente interpretação por IA mantendo os cálculos contabilísticos fora do modelo generativo.</p>
        <span class="home-feature-status">Evolução do produto</span>
    </article>
</section>
