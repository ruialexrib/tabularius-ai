@using System.Globalization
@using TabulariusAI.Web.Services
@inject IHomeDashboardService DashboardService
@{ViewData["Title"]="Início";var dashboard=await DashboardService.GetAsync(Context.RequestAborted);var maxTransactions=Math.Max(1,dashboard.Evolution.Select(x=>x.Transactions).DefaultIfEmpty(0).Max());var maxSales=Math.Max(1m,dashboard.Evolution.Select(x=>x.GrossSales).DefaultIfEmpty(0m).Max());}
<section class="dashboard-head"><div><p class="eyebrow">Visão geral</p><h1>O seu workspace contabilístico.</h1><p>Indicadores consolidados dos dados SAF-T (PT) disponíveis no Tabularius AI.</p></div><div class="dashboard-actions"><a class="btn btn-primary" asp-controller="Dossier" asp-action="Entities">Abrir dossiers</a><a class="btn btn-secondary" asp-controller="Home" asp-action="Import">Importar SAF-T</a></div></section>
<section class="dashboard-kpis" aria-label="Indicadores da aplicação"><article><span class="kpi-icon">EN</span><div><small>Entidades</small><strong>@dashboard.Entities</strong><p>entidades contabilísticas</p></div></article><article><span class="kpi-icon">DS</span><div><small>Dossiers</small><strong>@dashboard.Dossiers</strong><p>exercícios disponíveis</p></div></article><article><span class="kpi-icon">IM</span><div><small>Importações</small><strong>@dashboard.Imports</strong><p>ficheiros SAF-T persistidos</p></div></article><article><span class="kpi-icon">CT</span><div><small>Contas</small><strong>@dashboard.Accounts.ToString("N0",CultureInfo.GetCultureInfo("pt-PT"))</strong><p>registos contabilísticos</p></div></article><article><span class="kpi-icon">MV</span><div><small>Transações</small><strong>@dashboard.Transactions.ToString("N0",CultureInfo.GetCultureInfo("pt-PT"))</strong><p>movimentos disponíveis</p></div></article><article><span class="kpi-icon">€</span><div><small>Vendas</small><strong>@dashboard.GrossSales.ToString("N2",CultureInfo.GetCultureInfo("pt-PT")) €</strong><p>@dashboard.SalesDocuments documentos</p></div></article></section>
@if(dashboard.AiEnabled){<section class="dashboard-ai"><div class="dashboard-ai-mark">✦</div><div class="dashboard-ai-copy"><div class="dashboard-ai-meta"><span>Assistente AI ativo</span><i></i><span>@dashboard.AiProvider · @dashboard.AiModel</span></div><h2>Bem-vindo. Há @dashboard.Dossiers @(dashboard.Dossiers==1?"dossier disponível":"dossiers disponíveis") para análise.</h2>@if(dashboard.DossierSummaries.Count>0){<div class="dashboard-dossiers">@foreach(var dossier in dashboard.DossierSummaries){<a asp-controller="Dossier" asp-action="Details" asp-route-id="@dossier.Id"><span><strong>@dossier.Entity</strong><small>@dossier.Name · @dossier.FiscalYear</small></span><span class="dossier-mini"><b>@dossier.Transactions</b> movimentos · <b>@dossier.SalesDocuments</b> vendas</span><i>›</i></a>}</div>}<p class="dashboard-ai-next"><span>Próximo passo</span>@dashboard.AiWelcomePrompt</p></div></section>}
<section class="dashboard-chart-grid"><article class="dashboard-chart"><header><div><p class="section-kicker">Evolução</p><h2>Transações por exercício</h2></div><strong>@dashboard.Transactions.ToString("N0",CultureInfo.GetCultureInfo("pt-PT")) <small>total</small></strong></header><div class="bar-chart">@if(dashboard.Evolution.Count==0){<p class="chart-empty">Ainda não existem dados suficientes.</p>}else{@foreach(var point in dashboard.Evolution){var height=Math.Max(4,(double)point.Transactions/maxTransactions*100);<div class="bar-item"><div class="bar-value">@point.Transactions.ToString("N0",CultureInfo.GetCultureInfo("pt-PT"))</div><div class="bar-track"><span style="height:@height.ToString("0.##",CultureInfo.InvariantCulture)%"></span></div><small>@point.FiscalYear</small></div>}}</div></article><article class="dashboard-chart"><header><div><p class="section-kicker">Evolução</p><h2>Vendas brutas por exercício</h2></div><strong>@dashboard.GrossSales.ToString("N2",CultureInfo.GetCultureInfo("pt-PT")) € <small>total</small></strong></header><div class="bar-chart">@if(dashboard.Evolution.Count==0){<p class="chart-empty">Ainda não existem dados suficientes.</p>}else{@foreach(var point in dashboard.Evolution){var height=Math.Max(4,(double)(point.GrossSales/maxSales)*100);<div class="bar-item"><div class="bar-value">@point.GrossSales.ToString("N0",CultureInfo.GetCultureInfo("pt-PT")) €</div><div class="bar-track"><span style="height:@height.ToString("0.##",CultureInfo.InvariantCulture)%"></span></div><small>@point.FiscalYear</small></div>}}</div></article></section>
