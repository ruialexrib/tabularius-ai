@model TabulariusAI.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Erro da aplicação";
}

<section class="error-page" aria-labelledby="error-title">
    <div class="error-card">
        <div class="error-card-main">
            <div class="error-icon" aria-hidden="true">!</div>
            <div class="error-copy">
                <p class="eyebrow">Não foi possível concluir a operação</p>
                <h1 id="error-title">Ocorreu um erro.</h1>
                <p class="lead">A aplicação encontrou um problema inesperado ao processar o pedido. Os seus dados não devem ser reenviados até confirmar se a operação foi concluída.</p>

                <div class="error-guidance">
                    <strong>O que pode fazer agora</strong>
                    <p>Volte à página anterior e tente novamente. Se o problema persistir, indique o código de erro abaixo ao suporte para que o incidente possa ser localizado nos logs da aplicação.</p>
                </div>

                <div class="error-actions">
                    <button type="button" class="btn btn-primary" onclick="history.back()">Voltar e tentar novamente</button>
                    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Ir para o início</a>
                </div>
            </div>
        </div>

        @if (Model.ShowRequestId)
        {
            <aside class="error-reference" aria-label="Código do erro">
                <span class="error-reference-label">Código do erro</span>
                <code>@Model.RequestId</code>
                <p>Este código identifica exclusivamente este pedido e permite localizar o erro nos logs.</p>
                <div class="error-reference-note">
                    <strong>Ao contactar o suporte</strong>
                    <span>Copie este código exatamente como é apresentado.</span>
                </div>
            </aside>
        }
    </div>
</section>
