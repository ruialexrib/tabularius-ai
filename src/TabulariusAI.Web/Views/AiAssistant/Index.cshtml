@model TabulariusAI.Web.Models.AiChatViewModel
@{ViewData["Title"]="Assistente AI";}
<div class="assistant-page">
<header class="assistant-header"><div class="assistant-header-main"><span class="assistant-header-icon" aria-hidden="true">✦</span><div><div class="assistant-header-meta"><span>Assistente AI</span><span class="assistant-meta-dot"></span><span>@Model.DossierName</span></div><h1>Converse com os dados</h1><p>Analise a informação contabilística deste exercício com respostas fundamentadas nos dados persistidos do dossier.</p></div></div><div class="assistant-header-actions"><span class="assistant-readonly"><span class="assistant-readonly-dot"></span>Somente leitura</span><a class="btn btn-secondary" asp-controller="Dossier" asp-action="Details" asp-route-id="@Model.DossierId">Voltar ao dossier</a></div></header>
<section class="assistant-shell">
<div id="assistantMessages" class="assistant-messages" aria-live="polite">
<div class="assistant-welcome"><div class="assistant-intro"><span class="assistant-orb">✦</span><p class="eyebrow">Assistente do dossier</p><h2>O que pretende analisar?</h2><p>Escolha uma análise ou faça uma pergunta. As respostas são fundamentadas nos dados disponibilizados pelas tools do Tabularius AI.</p><div class="assistant-trust"><span>✓ Somente leitura</span><span>✓ Dossier selecionado</span><span>✓ Dados via tools</span></div></div><div class="assistant-suggestions"><button type="button" data-question="Resume os principais dados disponíveis neste dossier."><span>✦</span><strong>Resumo do dossier</strong><small>Visão geral do exercício</small></button><button type="button" data-question="Apresenta o balancete deste dossier, destacando as contas com maiores saldos devedores e credores."><span>≡</span><strong>Analisar balancete</strong><small>Contas, débitos, créditos e saldos</small></button><button type="button" data-question="Analisa as vendas deste dossier: total líquido, imposto, total bruto, número de documentos e período abrangido."><span>€</span><strong>Analisar vendas</strong><small>Faturação e principais indicadores</small></button><button type="button" data-question="Que clientes estão disponíveis neste dossier? Apresenta uma síntese dos clientes encontrados."><span>◉</span><strong>Consultar clientes</strong><small>Clientes e identificação fiscal</small></button><button type="button" data-question="Que fornecedores estão disponíveis neste dossier? Apresenta uma síntese dos fornecedores encontrados."><span>◇</span><strong>Consultar fornecedores</strong><small>Fornecedores e identificação fiscal</small></button><button type="button" data-question="Que produtos ou serviços estão disponíveis neste dossier? Apresenta uma síntese por código e descrição."><span>□</span><strong>Produtos e serviços</strong><small>Catálogo importado do SAF-T</small></button><button type="button" data-question="Mostra os documentos de venda mais recentes deste dossier, incluindo data, cliente e valores."><span>▤</span><strong>Documentos de venda</strong><small>Faturas e valores mais recentes</small></button><button type="button" data-question="Mostra os movimentos de mercadorias mais recentes deste dossier e resume os tipos de movimento encontrados."><span>↔</span><strong>Movimentos de stock</strong><small>Documentos de movimentação</small></button><button type="button" data-question="Apresenta a tabela de impostos deste dossier, incluindo tipos, códigos, descrições e taxas."><span>%</span><strong>Tabela de impostos</strong><small>Códigos e taxas fiscais SAF-T</small></button></div></div>
</div>
<div class="assistant-composer"><form id="assistantForm"><input id="assistantDossierId" type="hidden" value="@Model.DossierId"/><div class="assistant-input-wrap"><span class="composer-spark" aria-hidden="true">✦</span><textarea id="assistantQuestion" maxlength="2000" rows="1" placeholder="Pergunte sobre contas, vendas, clientes, fornecedores, produtos, impostos ou movimentos…"></textarea><button type="submit" aria-label="Enviar pergunta">↑</button></div><div class="assistant-caption"><span>Enter para enviar · Shift + Enter para nova linha</span><span id="assistantCounter">0 / 2000</span></div>@Html.AntiForgeryToken()</form></div>
</section></div>
@section Scripts { <script src="~/js/ai-assistant.js" asp-append-version="true"></script> }
