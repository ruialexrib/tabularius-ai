@model TabulariusAI.Web.Models.AiChatViewModel
@{ViewData["Title"]="Assistente AI";}
<div class="assistant-page">
<header class="assistant-header"><div class="assistant-header-main"><span class="assistant-header-icon" aria-hidden="true">✦</span><div><div class="assistant-header-meta"><span>Assistente AI</span><span class="assistant-meta-dot"></span><span>@Model.DossierName</span></div><h1>Converse com os dados</h1><p>Analise a informação contabilística deste exercício com respostas fundamentadas nos dados persistidos do dossier.</p></div></div><div class="assistant-header-actions"><span class="assistant-readonly"><span class="assistant-readonly-dot"></span>Somente leitura</span><a class="btn btn-secondary" asp-controller="Dossier" asp-action="Details" asp-route-id="@Model.DossierId">Voltar ao dossier</a></div></header>
<section class="assistant-shell">
<div id="assistantMessages" class="assistant-messages" aria-live="polite">
<div class="assistant-welcome"><div class="assistant-intro"><span class="assistant-orb">✦</span><p class="eyebrow">Assistente do dossier</p><h2>O que pretende analisar?</h2><p>As respostas sobre o exercício são fundamentadas nos dados disponibilizados pelas tools do Tabularius AI.</p><div class="assistant-trust"><span>✓ Somente leitura</span><span>✓ Dossier selecionado</span><span>✓ Dados via tools</span></div></div><div class="assistant-suggestions"><button type="button" data-question="Resume os dados disponíveis neste dossier."><span>✦</span><strong>Resumo do dossier</strong><small>Visão geral dos dados disponíveis</small></button><button type="button" data-question="Que informação contabilística está disponível neste dossier?"><span>▦</span><strong>Dados disponíveis</strong><small>Conhecer a informação importada</small></button><button type="button" data-question="Apresenta uma visão geral deste exercício sem inventar valores."><span>◇</span><strong>Visão do exercício</strong><small>Análise baseada apenas nos dados</small></button></div></div>
</div>
<div class="assistant-composer"><form id="assistantForm"><input id="assistantDossierId" type="hidden" value="@Model.DossierId"/><div class="assistant-input-wrap"><span class="composer-spark" aria-hidden="true">✦</span><textarea id="assistantQuestion" maxlength="2000" rows="1" placeholder="Pergunte sobre os dados deste dossier…"></textarea><button type="submit" aria-label="Enviar pergunta">↑</button></div><div class="assistant-caption"><span>Enter para enviar · Shift + Enter para nova linha</span><span id="assistantCounter">0 / 2000</span></div>@Html.AntiForgeryToken()</form></div>
</section></div>
@section Scripts { <script src="~/js/ai-assistant.js" asp-append-version="true"></script> }
