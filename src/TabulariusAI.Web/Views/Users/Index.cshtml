@model IReadOnlyCollection<TabulariusAI.Web.Models.UserListItemViewModel>
@{
    ViewData["Title"] = "Utilizadores";
}
<header class="page-header">
    <div><p class="eyebrow">Administração</p><h1>Utilizadores</h1><p class="lead">Gerir as contas com acesso ao Tabularius AI e os respetivos perfis.</p></div>
    <a class="btn btn-primary" asp-action="Create">Novo utilizador</a>
</header>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="status-message status-success">@successMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="status-message status-error">@errorMessage</div> }
<section class="panel">
    <div class="card-header"><div><p class="section-kicker">Acesso</p><h2>Contas da aplicação</h2><p>@Model.Count conta(s) registada(s).</p></div></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Utilizador</th><th>Nome</th><th>Email</th><th>Perfil</th><th>Estado</th><th>Criado em</th><th>Ações</th></tr></thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><strong>@user.UserName</strong></td><td>@user.DisplayName</td><td>@user.Email</td><td>@user.Role</td>
                    <td><span class="user-state @(user.IsLocked ? "user-state-locked" : "user-state-active")">@(user.IsLocked ? "Bloqueado" : "Ativo")</span></td>
                    <td>@user.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><form asp-action="ToggleLock" asp-route-id="@user.Id" method="post"><button type="submit" class="btn btn-secondary">@(user.IsLocked ? "Desbloquear" : "Bloquear")</button></form></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
