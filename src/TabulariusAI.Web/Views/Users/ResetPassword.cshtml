@model TabulariusAI.Web.Models.ResetUserPasswordViewModel
@{
    ViewData["Title"] = "Redefinir palavra-passe";
    var hasErrors = !ViewData.ModelState.IsValid;
}
<section class="user-editor-page" aria-labelledby="user-editor-title">
    <div class="user-editor-card">
        <div class="user-editor-main">
            <div class="user-editor-icon" aria-hidden="true">P</div>
            <div class="user-editor-copy">
                <p class="eyebrow">Administração de acessos</p>
                <h1 id="user-editor-title">Redefinir palavra-passe</h1>
                <p class="lead">Defina uma nova credencial para <strong>@Model.DisplayName</strong> (@Model.UserName).</p>
                @if (hasErrors) { <div class="user-editor-alert" role="alert"><span aria-hidden="true">!</span><div><strong>Não foi possível redefinir a palavra-passe</strong><div asp-validation-summary="All"></div></div></div> }
                <form asp-action="ResetPassword" method="post" class="user-editor-form">
                    <input asp-for="Id" type="hidden" />
                    <div class="user-editor-section">
                        <div class="user-editor-section-heading"><span>01</span><div><strong>Nova credencial</strong><small>A palavra-passe anterior deixa de ser válida após esta operação.</small></div></div>
                        <div class="user-editor-grid">
                            <div class="user-editor-field"><label asp-for="NewPassword">Nova palavra-passe</label><input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Defina uma palavra-passe segura" /><span asp-validation-for="NewPassword"></span></div>
                            <div class="user-editor-field"><label asp-for="ConfirmPassword">Confirmar palavra-passe</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repita a nova palavra-passe" /><span asp-validation-for="ConfirmPassword"></span></div>
                        </div>
                        <div class="user-password-rule"><span aria-hidden="true">✓</span><p><strong>Política de segurança</strong><small>Mínimo de 12 caracteres, com maiúscula, minúscula, algarismo e carácter especial.</small></p></div>
                    </div>
                    <div class="user-editor-actions"><button type="submit" class="btn btn-primary">Redefinir palavra-passe</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
                </form>
            </div>
        </div>
        <aside class="user-editor-reference" aria-label="Informação sobre redefinição da palavra-passe">
            <span class="user-editor-reference-label">Segurança</span><h2>Alteração administrativa</h2><p>Esta operação substitui a palavra-passe atual sem ser necessário conhecer a credencial anterior.</p>
            <div class="user-editor-reference-note"><strong>Sessões existentes</strong><span>O identificador de segurança da conta é renovado para que as sessões existentes deixem de ser consideradas válidas na próxima validação de segurança.</span></div>
            <div class="user-editor-reference-note"><strong>Utilizador</strong><span>@Model.DisplayName · @Model.UserName</span></div>
        </aside>
    </div>
</section>
