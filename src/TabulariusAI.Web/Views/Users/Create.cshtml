@model TabulariusAI.Web.Models.CreateUserViewModel
@using TabulariusAI.Web.Data.Identity
@{
    ViewData["Title"] = "Novo utilizador";
    var hasErrors = !ViewData.ModelState.IsValid;
}

<section class="user-editor-page" aria-labelledby="user-editor-title">
    <div class="user-editor-card">
        <div class="user-editor-main">
            <div class="user-editor-icon" aria-hidden="true">U</div>
            <div class="user-editor-copy">
                <p class="eyebrow">Administração de acessos</p>
                <h1 id="user-editor-title">Novo utilizador</h1>
                <p class="lead">Crie uma conta local, identifique o utilizador e defina o nível de acesso ao Tabularius AI.</p>

                @if (hasErrors)
                {
                    <div class="user-editor-alert" role="alert">
                        <span aria-hidden="true">!</span>
                        <div><strong>Não foi possível criar o utilizador</strong><div asp-validation-summary="All"></div></div>
                    </div>
                }

                <form asp-action="Create" method="post" class="user-editor-form">
                    <div class="user-editor-section">
                        <div class="user-editor-section-heading"><span>01</span><div><strong>Identificação</strong><small>Dados utilizados para identificar a conta na aplicação.</small></div></div>
                        <div class="user-editor-grid">
                            <div class="user-editor-field"><label asp-for="DisplayName">Nome a apresentar</label><input asp-for="DisplayName" autocomplete="name" placeholder="Ex.: Ana Martins" /><span asp-validation-for="DisplayName"></span></div>
                            <div class="user-editor-field"><label asp-for="UserName">Utilizador</label><input asp-for="UserName" autocomplete="off" placeholder="Ex.: ana.martins" /><span asp-validation-for="UserName"></span></div>
                            <div class="user-editor-field user-editor-field-wide"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" placeholder="nome@empresa.pt" /><span asp-validation-for="Email"></span></div>
                        </div>
                    </div>

                    <div class="user-editor-section">
                        <div class="user-editor-section-heading"><span>02</span><div><strong>Acesso e segurança</strong><small>Defina o perfil e a palavra-passe inicial da conta.</small></div></div>
                        <div class="user-editor-grid">
                            <div class="user-editor-field"><label asp-for="Role">Perfil</label><select asp-for="Role"><option value="@ApplicationRoles.User">Utilizador</option><option value="@ApplicationRoles.Administrator">Administrador</option></select><span asp-validation-for="Role"></span></div>
                            <div class="user-editor-field"><label asp-for="Password">Palavra-passe inicial</label><input asp-for="Password" type="password" autocomplete="new-password" placeholder="Defina uma palavra-passe segura" /><span asp-validation-for="Password"></span></div>
                        </div>
                        <div class="user-password-rule"><span aria-hidden="true">✓</span><p><strong>Política de segurança</strong><small>Mínimo de 12 caracteres, com maiúscula, minúscula, algarismo e carácter especial.</small></p></div>
                    </div>

                    <div class="user-editor-actions"><button type="submit" class="btn btn-primary">Criar utilizador</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
                </form>
            </div>
        </div>

        <aside class="user-editor-reference" aria-label="Informação sobre perfis de acesso">
            <span class="user-editor-reference-label">Controlo de acesso</span>
            <h2>Perfis da aplicação</h2>
            <p>Escolha o perfil de acordo com as responsabilidades do utilizador.</p>
            <div class="user-role-cards">
                <div><span>U</span><p><strong>Utilizador</strong><small>Acesso às áreas funcionais e aos dossiers contabilísticos autorizados.</small></p></div>
                <div><span>A</span><p><strong>Administrador</strong><small>Inclui a gestão de utilizadores e das configurações administrativas.</small></p></div>
            </div>
            <div class="user-editor-reference-note"><strong>Conta local</strong><span>O acesso é criado pelo administrador. Não existe registo público de utilizadores.</span></div>
        </aside>
    </div>
</section>
